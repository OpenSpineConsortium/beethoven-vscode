# >>> ashley (managed; "ashley install" rewrites this block) >>>
# VS Code Remote-SSH on this CentOS 7 grid (glibc 2.17) needs the sysroot C&IT provides.
# Source: WSU C&IT knowledge base, "How to SSH to the Grid in Visual Studio Code".
export VSCODE_SERVER_CUSTOM_GLIBC_LINKER="/wsu/apps/vscode/sysroot/x86_64-linux-gnu/x86_64-linux-gnu/sysroot/lib/ld-linux-x86-64.so.2"
export VSCODE_SERVER_CUSTOM_GLIBC_PATH="/wsu/apps/vscode/sysroot/x86_64-linux-gnu/x86_64-linux-gnu/sysroot/lib:/wsu/apps/vscode/sysroot/x86_64-linux-gnu/x86_64-linux-gnu/sysroot/lib64"
export VSCODE_SERVER_PATCHELF_PATH="/wsu/apps/vscode/patchelf/0.19.1/bin/patchelf"
# The Ashley grid CLI (ashley status, ashley worker start, ashley ask ...).
export PATH="$HOME/.ashley/bin:$PATH"
# <<< ashley <<<
