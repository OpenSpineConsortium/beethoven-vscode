#!/bin/bash
# ashley: the grid-side command. Lives at ~/.ashley/bin/ashley; the laptop calls it over
# ssh, students can call it from a grid shell. Bash + coreutils only, so it works on the
# login node without any environment. Nothing heavy runs here: building the container and
# running Claude happen in Slurm jobs.
#
#   ashley install [--root DIR]      layout, bashrc block, submit the bootstrap job
#   ashley status [--json]           ready? jobs, workers, accounts, quota
#   ashley doctor                    every check with a pass/fail line
#   ashley worker start --name N [--hours 24 --cpus 4 --mem 16G --partition reqp --qos requeue --gpus 0 --concurrency 2]
#   ashley worker stop|list|log|node [--name N] [--json] [--lines 80]
#   ashley send --worker N --json    (JSON request on stdin)  -> prints "queued <id>"
#   ashley wait [--worker N] [--timeout S] [--stream] <id>    -> result JSON (EVENT/RESULT lines with --stream)
#   ashley ask  --worker N --json [--stream] [--timeout S]    (JSON request on stdin) = send + wait
#   ashley result [--worker N] <id>
#   ashley tail [--worker N] <id>
#   ashley sessions [--json]
#   ashley accounts list|add-token NAME|add-key NAME|enable NAME|disable NAME|remove NAME
#   ashley bootstrap [--resubmit] [--update]
#   ashley version
set -uo pipefail
ASHLEY_HOME="${ASHLEY_HOME:-$HOME/.ashley}"
BIN="$ASHLEY_HOME/bin"
CFG="$ASHLEY_HOME/config.env"
VERSION=$(cat "$BIN/VERSION" 2>/dev/null || echo 0)
die() { echo "ashley: $*" >&2; exit 1; }
json_str() { # escape a string for JSON (control characters dropped)
  local s; s=$(printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037'); s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/}; s=${s//$'\t'/\\t}; printf '"%s"' "$s"
}
load_cfg() { [ -s "$CFG" ] && source "$CFG"; ROOT="${ROOT:-}"; RUNTIME="${RUNTIME:-}"; SANDBOX="${SANDBOX:-}"; CLAUDE_BIN="${CLAUDE_BIN:-}"; BOOTSTRAP_JOB="${BOOTSTRAP_JOB:-}"; BINDS="${BINDS:-}"; CONTAINER="${CONTAINER:-}"; SOURCE="${SOURCE:-}"; }
is_ready() { load_cfg; [ -s "$ASHLEY_HOME/READY" ] && [ -n "$CLAUDE_BIN" ] && [ -x "$CLAUDE_BIN" ] && [ -x "$SANDBOX/usr/local/bin/node" ]; }
job_state() { # $1 job id -> state or "" if gone
  [ -n "${1:-}" ] || { echo ""; return; }
  local s; s=$(squeue -j "$1" -h -o %T 2>/dev/null | head -1)
  [ -n "$s" ] && { echo "$s"; return; }
  sacct -j "$1" -n -X -o State -P 2>/dev/null | head -1 | cut -d' ' -f1
}
set_cfg() { # KEY VALUE
  mkdir -p "$ASHLEY_HOME"; touch "$CFG"
  { grep -v -E "^$1=" "$CFG"; printf '%s=%q\n' "$1" "$2"; } > "$CFG.part" && mv "$CFG.part" "$CFG"; chmod 600 "$CFG"
}
default_root() {
  if [ -d "/rs/rs_grp_oschome/$USER" ] && [ -w "/rs/rs_grp_oschome/$USER" ]; then echo "/rs/rs_grp_oschome/$USER/ashley"; else echo "$HOME/ashley"; fi
}

# ---- the lab's shared container library -------------------------------------------------
# One group-readable tree on the CephFS volume holds pre-built containers with Claude Code
# inside. A student who can read it adopts an entry in a second instead of building for seven
# minutes and 1.8 GB. Containers are read-only at run time: every account's state lives in its
# own home, so sharing costs nothing in isolation.
LIBRARY_ROOT="${ASHLEY_LIBRARY:-/rs/rs_grp_oschome/shared/ashley}"
SHARED="$(dirname "$LIBRARY_ROOT")"      # the lab folder: students read it, never write it
ACCESS_ROOT="$SHARED/access"
lib_file() { echo "$LIBRARY_ROOT/library.json"; }
lib_readable() { [ -r "$(lib_file)" ]; }
lib_field() { # NAME FIELD -> value (string fields only; python-free)
  local name="$1" field="$2"
  tr -d '\n' < "$(lib_file)" | grep -o "\"$name\": *{[^}]*}" | grep -o "\"$field\": *\"[^\"]*\"" | head -1 | sed 's/.*: *"\([^"]*\)"$/\1/'
}
lib_default() { tr -d '\n' < "$(lib_file)" | grep -o '"default": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/'; }
lib_names() { tr -d '\n' < "$(lib_file)" | grep -o '"containers": *{.*' | grep -o '"[A-Za-z0-9_.-]*": *{' | sed 's/"\([^"]*\)".*/\1/' | grep -v '^containers$'; }
cmd_library() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|--json)
      [ "$sub" = "--json" ] && set -- --json "$@"
      if ! lib_readable; then
        if [ "${1:-}" = "--json" ]; then echo '{"available":false,"root":"'"$LIBRARY_ROOT"'","containers":{}}'; else echo "no shared library readable at $LIBRARY_ROOT (ask your lead for the oschome group)"; fi; return 0
      fi
      if [ "${1:-}" = "--json" ]; then printf '{"available":true,"root":%s,"library":' "$(json_str "$LIBRARY_ROOT")"; tr -d '\n' < "$(lib_file)"; echo '}'
      else echo "shared library at $LIBRARY_ROOT (default: $(lib_default))"; for n in $(lib_names); do printf '  %-22s %s  [%s]%s\n' "$n" "$(lib_field "$n" purpose)" "$(lib_field "$n" claude_version)" "$([ "$(lib_field "$n" gpu)" = true ] && echo ' gpu' || true)"; done; fi;;
    publish)
      is_admin || die "only the lab admin publishes containers"
      # leads only: builds an entry as a job, then group-readable. ashley library publish --name NAME --image docker://... [--gpu] [--purpose "..."] [--partition P --qos Q]
      local name="" image="docker://node:22-bookworm" gpu=0 purpose="" part="secp" qos="secondary"
      while [ $# -gt 0 ]; do case "$1" in --name) name="$2"; shift 2;; --image) image="$2"; shift 2;; --gpu) gpu=1; shift;; --purpose) purpose="$2"; shift 2;; --partition) part="$2"; shift 2;; --qos) qos="$2"; shift 2;; *) shift;; esac; done
      [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]] || die "library publish needs --name"
      mkdir -p "$LIBRARY_ROOT" "$ASHLEY_HOME/log" || die "cannot create $LIBRARY_ROOT"
      chmod 2750 "$LIBRARY_ROOT" 2>/dev/null   # group reads, only the admin writes; approved students read by ACL
      local id; id=$(cd "$ASHLEY_HOME/log" && sbatch --parsable --partition="$part" --qos="$qos" --export="ALL,LIBRARY=1,ROOT_OVERRIDE=$LIBRARY_ROOT,LIB_NAME=$name,IMAGE=$image,GPU=$gpu,PURPOSE=$purpose" "$BIN/bootstrap.sbatch" 2>&1) || die "sbatch failed: $id"
      echo "publish job ${id%%;*} submitted: $name from $image into $LIBRARY_ROOT (log $ASHLEY_HOME/log/bootstrap_${id%%;*}.out)";;
    *) die "library: list|publish";;
  esac
}
cmd_adopt() { # use a shared container instead of building: writes config.env + READY
  local name="${1:-}"
  lib_readable || die "no shared library readable at $LIBRARY_ROOT"
  [ -n "$name" ] || name=$(lib_default)
  local sandbox claude runtime ver
  sandbox=$(lib_field "$name" sandbox); claude=$(lib_field "$name" claude_bin); runtime=$(lib_field "$name" runtime); ver=$(lib_field "$name" claude_version)
  [ -n "$sandbox" ] || die "no library entry '$name' (ashley library)"
  [ -x "$sandbox/usr/local/bin/node" ] || die "cannot read the shared container $sandbox (ask your lead for the oschome group)"
  [ -r "$claude" ] || die "cannot read $claude"
  load_cfg; [ -n "$ROOT" ] || set_cfg ROOT "$(default_root)"; load_cfg
  mkdir -p "$ROOT/workspaces" 2>/dev/null
  [ -O "/rs/rs_grp_oschome/$USER" ] && chmod o-rwx "/rs/rs_grp_oschome/$USER"
  local binds="-B $HOME"; [ -d "/rs/rs_grp_oschome/$USER" ] && binds="$binds -B /rs/rs_grp_oschome/$USER"
  case "$ROOT" in "/rs/rs_grp_oschome/$USER"/*|"$HOME"/*) ;; *) binds="$binds -B $ROOT";; esac
  binds="$binds -B $SHARED"   # the lab folder (containers, datasets, software), read-only by permission
  set_cfg RUNTIME "$runtime"; set_cfg SANDBOX "$sandbox"; set_cfg CLAUDE_BIN "$claude"; set_cfg BINDS "$binds"; set_cfg CONTAINER "$name"; set_cfg SOURCE "shared"; set_cfg BOOTSTRAP_STATE "adopted"
  printf '{"claude_version":"%s","runtime":"%s","sandbox":"%s","container":"%s","source":"shared","adopted":"%s","host":"%s"}\n' "$ver" "$runtime" "$sandbox" "$name" "$(date -u +%FT%TZ)" "$(hostname)" > "$ASHLEY_HOME/READY.part" && mv "$ASHLEY_HOME/READY.part" "$ASHLEY_HOME/READY"
  echo "adopted shared container '$name' ($ver); nothing to build"
}

cmd_install() {
  local root="" pass=() build_own=0
  while [ $# -gt 0 ]; do case "$1" in --root) root="$2"; shift 2;; --partition|--qos) pass+=("$1" "$2"); shift 2;; --build-own) build_own=1; shift;; *) shift;; esac; done
  mkdir -p "$ASHLEY_HOME"/{bin,log,accounts,workers,sessions} && chmod 700 "$ASHLEY_HOME" "$ASHLEY_HOME/accounts"
  # scripts uploaded from a Windows checkout may carry CR line endings, which break bash and sbatch
  for f in "$BIN"/ashley "$BIN"/*.sbatch "$BIN"/*.tpl "$BIN"/*.js "$BIN"/*.block; do [ -f "$f" ] && sed -i 's/\r$//' "$f"; done
  chmod +x "$BIN"/ashley "$BIN"/*.sbatch 2>/dev/null
  load_cfg
  [ -n "$root" ] && set_cfg ROOT "$root"
  load_cfg; [ -n "$ROOT" ] || set_cfg ROOT "$(default_root)"
  load_cfg
  mkdir -p "$ROOT" 2>/dev/null || die "cannot create ROOT=$ROOT"
  # bashrc block (VS Code glibc sysroot + PATH), idempotent by markers
  local rc="$HOME/.bashrc" blk="$BIN/bashrc.block"
  touch "$rc"
  if grep -q '# >>> ashley' "$rc"; then
    awk -v blk="$blk" 'BEGIN{skip=0} /^# >>> ashley/{skip=1; while ((getline l < blk) > 0) print l; next} /^# <<< ashley/{skip=0; next} skip==0{print}' "$rc" > "$rc.ashley.tmp" && mv "$rc.ashley.tmp" "$rc"
  else
    { echo; cat "$blk"; } >> "$rc"
  fi
  echo "installed ashley $VERSION at $ASHLEY_HOME (ROOT=$ROOT); bashrc block written"
  if is_ready; then echo "grid already ready: $(cat "$ASHLEY_HOME/READY")"; return 0; fi
  # the shared library first: instant, consistent across the lab, no storage used
  if [ $build_own -eq 0 ] && lib_readable && cmd_adopt "$(lib_default)" 2>/dev/null; then return 0; fi
  # Not readable yet. When the lab runs access requests, the container arrives with access (the
  # wizard's last step): do not spend 1.8 GB and seven minutes of the student's space on a copy.
  if [ $build_own -eq 0 ] && lab_mode; then
    set_cfg AWAITING_ACCESS 1
    echo "the lab's shared container comes with lab access: request it as the wizard's last step (Ashley: Lab access)"
    return 0
  fi
  cmd_bootstrap "${pass[@]}"
}

cmd_bootstrap() {
  # The bootstrap job defaults to reqp/requeue (the lab's CPU default). When that queue sits
  # PENDING (Priority) for long, --partition secp --qos secondary usually starts at once.
  local resubmit=0 update=0 part="" qos=""
  while [ $# -gt 0 ]; do case "$1" in --resubmit) resubmit=1; shift;; --update) update=1; shift;; --partition) part="$2"; shift 2;; --qos) qos="$2"; shift 2;; *) shift;; esac; done
  load_cfg
  if [ -n "$BOOTSTRAP_JOB" ] && [ $resubmit -eq 0 ] && [ $update -eq 0 ]; then
    local st; st=$(job_state "$BOOTSTRAP_JOB")
    case "$st" in PENDING|RUNNING|CONFIGURING|COMPLETING) echo "bootstrap job $BOOTSTRAP_JOB is $st"; return 0;; esac
  fi
  mkdir -p "$ASHLEY_HOME/log"
  local exp="ALL"; [ $update -eq 1 ] && exp="ALL,UPDATE=1"
  local extra=(); [ -n "$part" ] && extra+=(--partition="$part"); [ -n "$qos" ] && extra+=(--qos="$qos")
  local id; id=$(cd "$ASHLEY_HOME/log" && sbatch --parsable --export="$exp" "${extra[@]}" "$BIN/bootstrap.sbatch" 2>&1) || die "sbatch failed: $id"
  id=${id%%;*}
  set_cfg BOOTSTRAP_JOB "$id"; set_cfg BOOTSTRAP_STATE "submitted"
  echo "bootstrap job $id submitted (log: $ASHLEY_HOME/log/bootstrap_$id.out)"
}

home_quota() { # prints used_gb soft_gb or "0 0"
  local line; line=$(pan_quota 2>/dev/null | awk 'NR>2 && $1 ~ /^[0-9.]+$/ {print $1, $2; exit}')
  [ -n "$line" ] && { echo "$line"; return; }
  df -BG "$HOME" 2>/dev/null | awk 'NR==2 {gsub("G","",$3); gsub("G","",$2); print $3, $2}'
}

worker_dirs() { [ -d "$ASHLEY_HOME/workers" ] && for d in "$ASHLEY_HOME"/workers/*/; do [ -d "$d" ] && basename "$d"; done; }
worker_json() { # $1 name
  local w="$ASHLEY_HOME/workers/$1" jid st node alive="false" state="{}"
  jid=$(cat "$w/job.id" 2>/dev/null || echo ""); st=$(job_state "$jid"); node=$(cat "$w/node" 2>/dev/null || echo "")
  if [ -s "$w/state.json" ]; then state=$(tr -d '\n' < "$w/state.json"); fi
  if [ "$st" = "RUNNING" ] && [ -s "$w/state.json" ]; then
    local beat now; beat=$(stat -c %Y "$w/state.json" 2>/dev/null || echo 0); now=$(date +%s); [ $((now - beat)) -lt 90 ] && alive="true"
  fi
  local q; q=$(ls "$w/inbox" 2>/dev/null | grep -c '\.json$' || true)
  printf '{"name":%s,"job":%s,"job_state":%s,"node":%s,"alive":%s,"queued":%s,"state":%s}' "$(json_str "$1")" "$(json_str "$jid")" "$(json_str "${st:-none}")" "$(json_str "$node")" "$alive" "${q:-0}" "$state"
}
accounts_json() {
  local first=1; printf '['
  for d in "$ASHLEY_HOME"/accounts/*/; do
    [ -d "$d" ] || continue
    local n kind="none" en="true" cd="null"
    n=$(basename "$d")
    [ -s "$d/token" ] && kind="oauth-token"; [ -s "$d/apikey" ] && kind="api-key"; [ -s "$d/.credentials.json" ] && [ "$kind" = none ] && kind="login"
    [ "$kind" = none ] && continue
    [ -e "$d/disabled" ] && en="false"
    if [ -s "$d/state.json" ]; then local c; c=$(grep -o '"cooldown_until": *"[^"]*"' "$d/state.json" | head -1 | sed 's/.*"\([^"]*\)"$/\1/'); [ -n "$c" ] && cd="\"$c\""; fi
    [ $first -eq 1 ] || printf ','; first=0
    printf '{"name":%s,"kind":"%s","enabled":%s,"cooldown_until":%s}' "$(json_str "$n")" "$kind" "$en" "$cd"
  done; printf ']'
}
secrets_json() { # names (never values) of the variables in secrets.env
  local first=1; printf '['
  if [ -s "$ASHLEY_HOME/secrets.env" ]; then
    while IFS='=' read -r k _; do [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue; [ $first -eq 1 ] || printf ','; first=0; printf '"%s"' "$k"; done < "$ASHLEY_HOME/secrets.env"
  fi; printf ']'
}
jobs_json() {
  local first=1; printf '['
  while IFS='|' read -r i j t n m l p r; do
    [ -n "$i" ] || continue; [ $first -eq 1 ] || printf ','; first=0
    printf '{"jobId":%s,"name":%s,"state":%s,"node":%s,"elapsed":%s,"timeLimit":%s,"partition":%s,"reason":%s}' "$(json_str "$i")" "$(json_str "$j")" "$(json_str "$t")" "$(json_str "$n")" "$(json_str "$m")" "$(json_str "$l")" "$(json_str "$p")" "$(json_str "$r")"
  done < <(squeue -u "$USER" -h -o '%i|%j|%T|%N|%M|%l|%P|%R' 2>/dev/null); printf ']'
}
cmd_status() {
  local as_json=0; [ "${1:-}" = "--json" ] && as_json=1
  load_cfg
  if ! is_ready && lib_readable; then ( cmd_adopt "$(lib_default)" ) >/dev/null 2>&1; load_cfg; fi
  local ready=false cv="" bst=""
  is_ready && ready=true
  [ -s "$ASHLEY_HOME/READY" ] && cv=$(grep -o '"claude_version":"[^"]*"' "$ASHLEY_HOME/READY" | cut -d'"' -f4)
  [ -n "$BOOTSTRAP_JOB" ] && bst=$(job_state "$BOOTSTRAP_JOB")
  read -r used soft < <(home_quota)
  if [ $as_json -eq 1 ]; then
    local awaiting=false
    case "$bst" in PENDING|RUNNING|CONFIGURING) ;; *) if [ "$ready" = false ] && ! lib_readable && lab_mode; then awaiting=true; fi;; esac
    printf '{"version":%s,"host":%s,"ready":%s,"awaiting_access":%s,"root":%s,"runtime":%s,"claude_version":%s,"container":%s,"source":%s,"library":%s,"bootstrap_job":%s,"bootstrap_state":%s,"home_used_gb":%s,"home_soft_gb":%s,"workers":[' \
      "$(json_str "$VERSION")" "$(json_str "$(hostname)")" "$ready" "$awaiting" "$(json_str "$ROOT")" "$(json_str "$RUNTIME")" "$(json_str "$cv")" "$(json_str "${CONTAINER:-own}")" "$(json_str "${SOURCE:-own}")" "$(lib_readable && echo true || echo false)" "$(json_str "$BOOTSTRAP_JOB")" "$(json_str "$bst")" "${used:-0}" "${soft:-0}"
    local first=1; for w in $(worker_dirs); do [ $first -eq 1 ] || printf ','; first=0; worker_json "$w"; done
    printf '],"accounts":%s,"secrets":%s,"jobs":%s}\n' "$(accounts_json)" "$(secrets_json)" "$(jobs_json)"
  else
    echo "ashley $VERSION on $(hostname)  ready=$ready  claude=${cv:-?}  root=${ROOT:-?}"
    [ -n "$BOOTSTRAP_JOB" ] && echo "bootstrap job $BOOTSTRAP_JOB: ${bst:-finished}"
    echo "home: ${used:-?} GB used of ${soft:-?} GB soft quota"
    echo "accounts: $(accounts_json)"
    echo "workers:"; for w in $(worker_dirs); do echo "  $(worker_json "$w")"; done
    echo "jobs:"; squeue -u "$USER" -o '%.10i %.18j %.9T %.12N %.10M %.11l %.8P %R' 2>/dev/null
  fi
}

cmd_doctor() {
  load_cfg; local fail=0
  ok() { echo "PASS  $*"; }; bad() { echo "FAIL  $*"; fail=1; }
  [ -x "$BIN/ashley" ] && ok "ashley $VERSION installed at $BIN" || bad "ashley not executable"
  grep -q '# >>> ashley' "$HOME/.bashrc" && ok "bashrc block present (VS Code glibc sysroot, PATH)" || bad "bashrc block missing: run ashley install"
  for f in /wsu/apps/vscode/sysroot/x86_64-linux-gnu/x86_64-linux-gnu/sysroot/lib/ld-linux-x86-64.so.2 /wsu/apps/vscode/patchelf/0.19.1/bin/patchelf; do [ -e "$f" ] && ok "C&IT VS Code sysroot: $f" || bad "missing $f (C&IT moved the sysroot?)"; done
  [ -n "$ROOT" ] && [ -w "$ROOT" ] && ok "ROOT $ROOT writable" || bad "ROOT not writable (${ROOT:-unset})"
  if is_ready; then ok "READY: $(cat "$ASHLEY_HOME/READY")"; else bad "not ready (bootstrap job ${BOOTSTRAP_JOB:-none}: $(job_state "$BOOTSTRAP_JOB"))"; fi
  [ -n "$RUNTIME" ] && [ -x "$RUNTIME" ] && ok "runtime $RUNTIME" || bad "runtime missing on this host (fine on the login node if the compute nodes have it)"
  local n; n=$(accounts_json | grep -o '"name"' | wc -l); [ "$n" -gt 0 ] && ok "$n Claude account(s): $(accounts_json)" || bad "no Claude account (setup wizard step 'Claude token', or ashley accounts add-token default)"
  [ -s "$ASHLEY_HOME/secrets.env" ] && ok "secrets.env present ($(stat -c %a "$ASHLEY_HOME/secrets.env")): $(cmd_verify_tokens 2>/dev/null | tr '\n' ';')" || bad "secrets.env missing (GitHub / Hugging Face tokens for the worker)"
  read -r used soft < <(home_quota); ok "home quota ${used:-?}/${soft:-?} GB"
  for w in $(worker_dirs); do echo "      worker $(worker_json "$w")"; done
  [ $fail -eq 0 ] && echo "doctor: all checks passed" || echo "doctor: some checks failed"
  return $fail
}

cmd_worker() {
  local sub="${1:-list}"; shift || true
  local name="default" hours=24 cpus=4 mem="16G" part="reqp" qos="requeue" gpus=0 conc=2 lines=80 as_json=0 container=""
  while [ $# -gt 0 ]; do case "$1" in
    --name) name="$2"; shift 2;; --hours) hours="$2"; shift 2;; --cpus) cpus="$2"; shift 2;; --mem) mem="$2"; shift 2;;
    --partition) part="$2"; shift 2;; --qos) qos="$2"; shift 2;; --gpus) gpus="$2"; shift 2;; --concurrency) conc="$2"; shift 2;;
    --container) container="$2"; shift 2;;
    --lines) lines="$2"; shift 2;; --json) as_json=1; shift;; *) shift;; esac; done
  [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "worker name must be letters, digits, _ or -"
  local w="$ASHLEY_HOME/workers/$name"
  case "$sub" in
    start)
      # access granted since the last install: adopt the lab's container on the spot
      if ! is_ready && lib_readable; then ( cmd_adopt "$(lib_default)" ) >/dev/null 2>&1; load_cfg; fi
      if ! is_ready && ! lib_readable && lab_mode; then die "no container yet: it comes with lab access (the last setup step; your lead approves it)"; fi
      is_ready || die "grid not ready yet (bootstrap job ${BOOTSTRAP_JOB:-none}: $(job_state "${BOOTSTRAP_JOB:-}")); try again when 'ashley status' says ready=true"
      mkdir -p "$w"/{inbox,outbox,log}
      rm -f "$w/stop"
      local jid st; jid=$(cat "$w/job.id" 2>/dev/null || echo ""); st=$(job_state "$jid")
      case "$st" in PENDING|RUNNING|CONFIGURING) echo "worker $name already has job $jid ($st) on $(cat "$w/node" 2>/dev/null || echo '?')"; return 0;; esac
      [[ "$hours" =~ ^[0-9]+$ ]] || die "--hours must be an integer"
      local time; time=$(printf '%d-%02d:00:00' $((hours / 24)) $((hours % 24)))
      local gres="" requeue="#SBATCH --no-requeue" w_sandbox="" w_claude=""
      [ "$gpus" != "0" ] && gres="#SBATCH --gres=gpu:$gpus"
      [ "$qos" = "requeue" ] && requeue="#SBATCH --requeue"
      if [ -n "$container" ]; then
        lib_readable || die "--container needs the shared library ($LIBRARY_ROOT)"
        w_sandbox=$(lib_field "$container" sandbox); w_claude=$(lib_field "$container" claude_bin)
        [ -n "$w_sandbox" ] || die "no library entry '$container' (ashley library)"
        [ -x "$w_sandbox/usr/local/bin/node" ] || die "cannot read the shared container $w_sandbox"
        echo "$container" > "$w/container"
      fi
      sed -e "s|@NAME@|$name|g" -e "s|@PARTITION@|$part|g" -e "s|@QOS@|$qos|g" -e "s|@CPUS@|$cpus|g" -e "s|@MEM@|$mem|g" \
          -e "s|@TIME@|$time|g" -e "s|@GRES@|$gres|g" -e "s|@REQUEUE@|$requeue|g" -e "s|@GPUS@|$gpus|g" -e "s|@CONC@|$conc|g" \
          -e "s|@SANDBOX@|$w_sandbox|g" -e "s|@CLAUDE_BIN@|$w_claude|g" -e "s|@LIBRARY@|$SHARED|g" \
          "$BIN/worker.sbatch.tpl" > "$w/job.sbatch"
      local out; out=$(cd "$w" && sbatch --parsable job.sbatch 2>&1) || die "sbatch failed: $out"
      jid=${out%%;*}; echo "$jid" > "$w/job.id"; rm -f "$w/node"
      echo "submitted worker $name as job $jid ($part/$qos, $cpus cpu, $mem, $time, gpus=$gpus, concurrency=$conc${container:+, container $container})";;
    stop)
      [ -d "$w" ] || die "no worker $name"
      touch "$w/stop"
      local jid; jid=$(cat "$w/job.id" 2>/dev/null || echo "")
      [ -n "$jid" ] && scancel "$jid" 2>/dev/null
      echo "worker $name stopped (job ${jid:-none} cancelled)";;
    list)
      if [ $as_json -eq 1 ]; then printf '{"workers":['; local first=1; for x in $(worker_dirs); do [ $first -eq 1 ] || printf ','; first=0; worker_json "$x"; done; printf ']}\n'
      else for x in $(worker_dirs); do worker_json "$x"; echo; done; fi;;
    log)
      [ -d "$w" ] || die "no worker $name"
      echo "--- ashleyd.log"; tail -n "$lines" "$w/log/ashleyd.log" 2>/dev/null
      echo "--- slurm"; ls -t "$w"/log/slurm_*.out 2>/dev/null | head -1 | xargs -r tail -n 40;;
    node)
      [ -s "$w/node" ] || die "worker $name has no node yet ($(job_state "$(cat "$w/job.id" 2>/dev/null)"))"
      cat "$w/node";;
    *) die "worker: start|stop|list|log|node";;
  esac
}

# ---- requests ---------------------------------------------------------------------------
req_id_from_stdin() { # reads JSON on stdin into $REQ, extracts id
  REQ=$(cat); [ -n "$REQ" ] || die "expected a JSON request on stdin"
  RID=$(printf '%s' "$REQ" | grep -o '"id": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
  [[ "$RID" =~ ^[A-Za-z0-9_.-]+$ ]] || die "request JSON needs an id"
}
enqueue() { # $1 worker; uses REQ/RID; prints the queued line
  local worker="$1" w="$ASHLEY_HOME/workers/$1"
  [ -d "$w" ] || die "no worker '$worker' (ashley worker start --name $worker)"
  mkdir -p "$w/inbox" "$w/outbox"
  printf '%s' "$REQ" > "$w/inbox/$RID.json.part" && mv "$w/inbox/$RID.json.part" "$w/inbox/$RID.json"
  local jid st n; jid=$(cat "$w/job.id" 2>/dev/null || echo ""); st=$(job_state "$jid"); n=$(ls "$w/inbox" 2>/dev/null | grep -c '\.json$' || true)
  echo "queued $RID on worker $worker (job ${jid:-none} ${st:-not running}; ${n:-0} waiting)"
}
cmd_send() {
  local worker="default"
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; *) shift;; esac; done
  req_id_from_stdin
  enqueue "$worker"
}
cmd_wait() {
  local worker="default" timeout=3600 stream=0 id=""
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; --timeout) timeout="$2"; shift 2;; --stream) stream=1; shift;; --json) shift;; *) id="$1"; shift;; esac; done
  [[ "$id" =~ ^[A-Za-z0-9_.-]+$ ]] || die "wait: request id required"
  local w="$ASHLEY_HOME/workers/$worker" out="$ASHLEY_HOME/workers/$worker/outbox/$id.json" ev="$ASHLEY_HOME/workers/$worker/outbox/$id.events.jsonl"
  local start; start=$(date +%s); local off=0
  while :; do
    if [ $stream -eq 1 ] && [ -f "$ev" ]; then
      local size; size=$(stat -c %s "$ev" 2>/dev/null || echo 0)
      if [ "$size" -gt "$off" ]; then tail -c +$((off + 1)) "$ev" | head -c $((size - off)) | sed 's/^/EVENT /'; off=$size; fi
    fi
    if [ -s "$out" ]; then
      if [ $stream -eq 1 ]; then printf 'RESULT '; tr -d '\n' < "$out"; echo; else cat "$out"; fi
      return 0
    fi
    if [ $(( $(date +%s) - start )) -ge "$timeout" ]; then
      [ $stream -eq 1 ] && echo "TIMEOUT $id"
      echo "ashley: no result for $id after ${timeout}s (worker job $(cat "$w/job.id" 2>/dev/null) $(job_state "$(cat "$w/job.id" 2>/dev/null)"))" >&2; return 124
    fi
    sleep 0.5
  done
}
cmd_ask() {
  local worker="default" timeout=3600 stream=""
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; --timeout) timeout="$2"; shift 2;; --stream) stream="--stream"; shift;; *) shift;; esac; done
  req_id_from_stdin
  local msg; msg=$(enqueue "$worker") || exit 1
  [ -n "$stream" ] && echo "QUEUED $msg"
  # shellcheck disable=SC2086
  cmd_wait --worker "$worker" --timeout "$timeout" $stream "$RID"
}
cmd_result() {
  local worker="default" id=""
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; *) id="$1"; shift;; esac; done
  local f="$ASHLEY_HOME/workers/$worker/outbox/$id.json"; [ -s "$f" ] || { echo "no result yet for $id" >&2; exit 1; }; cat "$f"
}
cmd_tail() {
  local worker="default" id=""
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; *) id="$1"; shift;; esac; done
  tail -n 50 -f "$ASHLEY_HOME/workers/$worker/outbox/$id.events.jsonl"
}
cmd_sessions() {
  local as_json=0; [ "${1:-}" = "--json" ] && as_json=1
  if [ $as_json -eq 1 ]; then printf '{"sessions":['; local first=1; for f in "$ASHLEY_HOME"/sessions/*.json; do [ -s "$f" ] || continue; [ $first -eq 1 ] || printf ','; first=0; tr -d '\n' < "$f"; done; printf ']}\n'
  else for f in "$ASHLEY_HOME"/sessions/*.json; do [ -s "$f" ] && { basename "$f" .json; sed 's/^/    /' "$f"; }; done; fi
}
cmd_accounts() {
  local sub="${1:-list}" name="${2:-}"; local d="$ASHLEY_HOME/accounts/$name"
  case "$sub" in
    list) accounts_json; echo;;
    add-token) [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "accounts add-token NAME (token on stdin)"; umask 077; mkdir -p "$d"; head -1 | tr -d '\r\n' > "$d/token"; [ -s "$d/token" ] || die "empty token"; rm -f "$d/apikey" "$d/disabled" "$d/state.json"; echo "account $name: oauth token stored";;
    add-key) [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "accounts add-key NAME (key on stdin)"; umask 077; mkdir -p "$d"; head -1 | tr -d '\r\n' > "$d/apikey"; [ -s "$d/apikey" ] || die "empty key"; rm -f "$d/token" "$d/disabled" "$d/state.json"; echo "account $name: api key stored";;
    enable) [ -d "$d" ] || die "no account $name"; rm -f "$d/disabled" "$d/state.json"; echo "account $name enabled";;
    disable) [ -d "$d" ] || die "no account $name"; touch "$d/disabled"; echo "account $name disabled";;
    remove) [ -d "$d" ] || die "no account $name"; rm -rf "$d"; echo "account $name removed";;
    *) die "accounts: list|add-token NAME|add-key NAME|enable NAME|disable NAME|remove NAME";;
  esac
}

cmd_relay() {
  # One long-lived ssh session instead of one per message. Protocol, one line each way:
  #   -> SEND <worker> <json>        queue a request        <- QUEUED <id> <epoch_ms>
  #   -> RESULT <worker> <id>        ask for a result       <- RESULT <id> <json> | PENDING <id>
  #   -> PING                                               <- PONG <epoch_ms>
  #   -> QUIT
  # Results and events of everything queued through this session are pushed as they appear:
  #   <- EVENT <id> <json line>   <- RESULT <id> <json>
  # The loop wakes every 250 ms (read -t) to look at pending files; a sleep-and-stat loop is
  # the kind of load the login node is for.
  local -A pw poff   # id -> worker, id -> events offset
  local line cmd rest worker json id
  echo "READY $(date +%s%3N) $VERSION"
  while :; do
    if IFS= read -r -t 0.25 line; then
      cmd=${line%% *}; rest=${line#* }
      case "$cmd" in
        SEND)
          worker=${rest%% *}; json=${rest#* }
          id=$(printf '%s' "$json" | grep -o '"id": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
          if [[ ! "$id" =~ ^[A-Za-z0-9_.-]+$ ]] || [ ! -d "$ASHLEY_HOME/workers/$worker" ]; then echo "ERROR bad request or unknown worker '$worker'"; continue; fi
          mkdir -p "$ASHLEY_HOME/workers/$worker/inbox" "$ASHLEY_HOME/workers/$worker/outbox"
          printf '%s' "$json" > "$ASHLEY_HOME/workers/$worker/inbox/$id.json.part" && mv "$ASHLEY_HOME/workers/$worker/inbox/$id.json.part" "$ASHLEY_HOME/workers/$worker/inbox/$id.json"
          pw[$id]=$worker; poff[$id]=0
          echo "QUEUED $id $(date +%s%3N)";;
        RESULT)
          worker=${rest%% *}; id=${rest#* }
          if [ -s "$ASHLEY_HOME/workers/$worker/outbox/$id.json" ]; then printf 'RESULT %s ' "$id"; tr -d '\n' < "$ASHLEY_HOME/workers/$worker/outbox/$id.json"; echo; else echo "PENDING $id"; fi;;
        PING) echo "PONG $(date +%s%3N)";;
        QUIT) exit 0;;
        *) echo "ERROR unknown command";;
      esac
    else
      [ $? -gt 128 ] || exit 0   # stdin closed: the laptop went away
      for id in "${!pw[@]}"; do
        worker=${pw[$id]}
        local ev="$ASHLEY_HOME/workers/$worker/outbox/$id.events.jsonl" out="$ASHLEY_HOME/workers/$worker/outbox/$id.json"
        if [ -f "$ev" ]; then
          local size; size=$(stat -c %s "$ev" 2>/dev/null || echo 0)
          if [ "$size" -gt "${poff[$id]}" ]; then tail -c +$(( poff[$id] + 1 )) "$ev" | head -c $(( size - poff[$id] )) | sed "s/^/EVENT $id /"; poff[$id]=$size; fi
        fi
        if [ -s "$out" ]; then printf 'RESULT %s ' "$id"; tr -d '\n' < "$out"; echo; unset "pw[$id]" "poff[$id]"; fi
      done
    fi
  done
}

# ---- lab access: one folder, read-only, requests carried by Slurm ---------------------------
# Philosophy: the lab admin curates the lab folder SHARED=/rs/rs_grp_oschome/shared (datasets,
# containers, software). Students only ever READ it; they do all their science in their own grid
# accounts. So nothing under the volume is writable by students, not even a request drop-box.
#
# A request is a held, zero-work Slurm job named ashley_access whose comment carries the note.
# Slurm authenticates the submitter, so a request cannot be forged or squatted, and it uses no
# storage. The admin's ingest reads them (squeue shows every user's jobs on this grid), writes a
# status file only the admin can write and only that student can read, and gives the applicant a
# traverse-only ACL on the path to it. Approval = POSIX ACLs (CephFS honours them; the admin owns
# the volume): read-only on SHARED and everything under it except access/. The volume root is not
# open to other users at all.
#   /rs/rs_grp_oschome      2770 + per-user --x ACLs    (default ACL o::--- for new entries)
#   shared/                 2750 + per-user r-x/--x     (group reads, only the admin writes)
#   shared/<anything>       2750 + per-user r-X         (containers, datasets, software)
#   shared/access           2710 + per-user --x
#   shared/access/status    2710 + per-user --x; status/<id>.json 600 + ACL u:<id>:r--
#   shared/access/requests  2700  the admin's decision log
VOL="$(dirname "$SHARED")"
STATUS_DIR="$ACCESS_ROOT/status"
LOG_DIR="$ACCESS_ROOT/requests"
access_admin() { stat -c %U "$SHARED" 2>/dev/null || echo "${ASHLEY_ADMIN:-}"; }
is_admin() { [ "$(access_admin)" = "$USER" ]; }
lab_mode() { [ "${ASHLEY_LAB:-1}" = 1 ]; }    # Ashley is the lab's tool: the container comes with lab access
status_file() { echo "$STATUS_DIR/$1.json"; }
status_field() { # ID FIELD
  [ -r "$(status_file "$1")" ] || { echo ""; return; }
  grep -o "\"$2\": *\"[^\"]*\"" "$(status_file "$1")" | head -1 | sed 's/.*"\([^"]*\)"$/\1/'
}
own_request_job() { squeue -h -u "$USER" -n ashley_access -t PD -o %i 2>/dev/null | head -1; }
sanitize_note() { printf '%s' "$1" | tr -cd 'A-Za-z0-9 ,.:;()/_@+-' | cut -c1-200; }
decision_log() { printf '%s %s %s %s\n' "$(date -u +%FT%TZ)" "$1" "$2" "$3" >> "$LOG_DIR/decisions.log" 2>/dev/null; }
write_status() { # ID STATE NOTE MESSAGE REQUESTED JOB
  local f; f=$(status_file "$1")
  ( umask 077
    printf '{"user":%s,"name":%s,"state":%s,"note":%s,"message":%s,"requested":%s,"job":%s,"decided":%s,"by":%s}\n' \
      "$(json_str "$1")" "$(json_str "$(getent passwd "$1" | cut -d: -f5)")" "$(json_str "$2")" "$(json_str "$3")" "$(json_str "$4")" "$(json_str "$5")" "$(json_str "$6")" "$(json_str "$(date -u +%FT%TZ)")" "$(json_str "$USER")" > "$f.part" && mv "$f.part" "$f" )
  setfacl -m "u:$1:r--" "$f" 2>/dev/null || chmod 644 "$f"
}
path_traverse() { # ID add|remove: pass-through to the applicant's own status file
  local d
  for d in "$VOL" "$SHARED" "$ACCESS_ROOT" "$STATUS_DIR"; do
    if [ "$2" = add ]; then setfacl -m "u:$1:--x" "$d" 2>/dev/null; else setfacl -x "u:$1" "$d" 2>/dev/null; fi
  done
}
acl_grant() { # ID: read-only on everything in the lab folder except access/; returns the failure count
  local fails=0 c
  setfacl -m "u:$1:--x" "$VOL" || fails=$((fails + 1))
  setfacl -m "u:$1:r-x" "$SHARED" && setfacl -d -m "u:$1:r-X" "$SHARED" || fails=$((fails + 1))
  for c in "$SHARED"/*; do
    [ "$c" = "$ACCESS_ROOT" ] && continue
    [ -L "$c" ] && continue                        # never follow a link out of the lab folder
    [ -e "$c" ] || continue
    setfacl -R -P -m "u:$1:r-X" "$c" 2>/dev/null || fails=$((fails + 1))
    find "$c" -type d -exec setfacl -d -m "u:$1:r-X" {} + 2>/dev/null
  done
  return $fails
}
acl_revoke() { # ID: removes read access to the lab folder (keeps the pass-through to the status file)
  local c
  for c in "$SHARED"/*; do
    [ "$c" = "$ACCESS_ROOT" ] && continue
    [ -L "$c" ] && continue
    setfacl -R -P -x "u:$1" "$c" 2>/dev/null; find "$c" -type d -exec setfacl -d -x "u:$1" {} + 2>/dev/null
  done
  setfacl -d -x "u:$1" "$SHARED" 2>/dev/null; setfacl -m "u:$1:--x" "$SHARED" 2>/dev/null
  return 0
}
approved_users() { local f; for f in "$STATUS_DIR"/*.json; do [ -s "$f" ] || continue; grep -q '"state": *"approved"' "$f" && basename "$f" .json; done; }
# curl with a secret header, without the secret ever appearing in the process list
curl_auth() { # TOKEN URL [extra header lines...]
  local tok="$1" url="$2"; shift 2
  { printf 'header = "Authorization: Bearer %s"\n' "$tok"; for h in "$@"; do printf 'header = "%s"\n' "$h"; done; } | curl -s -m 15 -K - "$url"
}
curl_auth_code() { # TOKEN URL [extra header lines...] -> HTTP status code
  local tok="$1" url="$2"; shift 2
  { printf 'header = "Authorization: Bearer %s"\n' "$tok"; for h in "$@"; do printf 'header = "%s"\n' "$h"; done; } | curl -s -m 15 -o /dev/null -w '%{http_code}' -K - "$url"
}
student_state() { # none | filed | pending | approved | approved_unreadable | denied | removed
  if lib_readable; then echo approved; return; fi
  local s; s=$(status_field "$USER" state)
  case "$s" in
    approved) echo approved_unreadable;;
    pending|denied|removed) echo "$s";;
    *) [ -n "$(own_request_job)" ] && echo filed || echo none;;
  esac
}
tidy_request_job() { # once decided, the held request job has done its job
  local s; s=$(student_state)
  case "$s" in approved|approved_unreadable|denied|removed) local j; j=$(own_request_job); [ -n "$j" ] && scancel "$j" 2>/dev/null;; esac
}
admin_ingest() { # read pending request jobs; open a status file for each new applicant
  local line id u note req
  while IFS='|' read -r id u note req; do
    [ -n "$u" ] || continue
    getent passwd "$u" >/dev/null || continue
    [ -s "$(status_file "$u")" ] && continue       # already known (pending or decided)
    note=$(sanitize_note "${note#ashley-access v1 note=}")
    path_traverse "$u" add
    write_status "$u" pending "$note" "" "$req" "$id"
    decision_log "$u" filed "job $id"
  done < <(squeue -h -n ashley_access -t PD -o '%i|%u|%k|%V' 2>/dev/null)
}
cmd_access() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    init)  # admin: the permission layout, printed as it is applied; safe to rerun
      is_admin || die "only the owner of $SHARED can run access init"
      local e others=""
      chmod o-rwx "$VOL" && echo "chmod o-rwx $VOL (no longer open to other grid users)"
      setfacl -d -m u::rwx,g::rwx,o::--- "$VOL" 2>/dev/null && echo "default ACL on $VOL: new entries start closed to others"
      for e in "$VOL"/*; do
        [ "$e" = "$SHARED" ] && continue
        if [ "$(stat -c %U "$e")" = "$USER" ]; then chmod o-rwx "$e"; elif [ -n "$(find "$e" -maxdepth 0 -perm /o=rwx 2>/dev/null)" ]; then others="$others $e"; fi
      done
      [ -n "$others" ] && echo "note: these entries belong to other members and are open to others; their owners can close them with chmod o-rwx:$others"
      chmod 2750 "$SHARED" && setfacl -d -m u::rwx,g::r-x,o::--- "$SHARED" && echo "chmod 2750 $SHARED (group reads, only you write; new entries closed to others)"
      for e in "$SHARED"/*; do
        [ "$e" = "$ACCESS_ROOT" ] && continue; [ -L "$e" ] && continue
        chmod -R g-w,o-rwx "$e" 2>/dev/null; find "$e" -type d -exec chmod g+s {} + 2>/dev/null
      done
      echo "lab folder contents: group read-only, closed to others"
      mkdir -p "$STATUS_DIR" "$LOG_DIR"
      rm -rf "$ACCESS_ROOT/inbox" && echo "removed the old world-writable drop-box"
      chmod 2710 "$ACCESS_ROOT" "$STATUS_DIR"; chmod 2700 "$LOG_DIR"
      local f; for f in "$STATUS_DIR"/*.json; do [ -s "$f" ] || continue; chmod 600 "$f"; setfacl -m "u:$(basename "$f" .json):r--" "$f" 2>/dev/null; path_traverse "$(basename "$f" .json)" add; done
      mkdir -p "$ASHLEY_HOME/bin"; printf '#!/bin/bash\ntrue\n' > "$BIN/access_request.sbatch"; chmod 755 "$BIN/access_request.sbatch"
      cmd_access admin resync >/dev/null && echo "re-applied access for approved users"
      echo "access ready: requests arrive as held Slurm jobs named ashley_access";;
    whoami)
      local adm st; adm=$(access_admin); st=$(is_admin && echo admin || student_state)
      is_admin || tidy_request_job
      if [ "${1:-}" = "--json" ]; then printf '{"user":%s,"admin":%s,"lab_admin":%s,"granted":%s,"state":%s}\n' "$(json_str "$USER")" "$(is_admin && echo true || echo false)" "$(json_str "$adm")" "$(lib_readable && echo true || echo false)" "$(json_str "$st")"
      else echo "user $USER; lab admin $adm; state $st"; fi;;
    status)
      local st; st=$(student_state); tidy_request_job
      if [ "${1:-}" = "--json" ]; then
        printf '{"granted":%s,"state":%s,"message":%s,"decided":%s}\n' "$(lib_readable && echo true || echo false)" "$(json_str "$st")" "$(json_str "$(status_field "$USER" message)")" "$(json_str "$(status_field "$USER" decided)")"
      else echo "lab access: $st$([ -n "$(status_field "$USER" message)" ] && echo " ($(status_field "$USER" message))")"; fi;;
    requirements)
      # A request is the LAST step: everything the lab works with must already work. The shared
      # container is not a requirement: it is what access gives.
      local missing=() as_json=0; [ "${1:-}" = "--json" ] && as_json=1
      local vt; vt=$(cmd_verify_tokens 2>/dev/null || true)
      if echo "$vt" | grep -q "^CLAUDE_TOKEN missing"; then missing+=("no Claude subscription token on the grid (Claude step; Claude Pro is the minimum)")
      elif echo "$vt" | grep -q "^CLAUDE_TOKEN rejected"; then missing+=("the Claude token on the grid was rejected (expired or revoked): renew it with the Claude step")
      elif ! echo "$vt" | grep -q "^CLAUDE_TOKEN ok"; then missing+=("the Claude token could not be confirmed right now ($(echo "$vt" | grep '^CLAUDE_TOKEN' | cut -c1-80)); try again in a minute")
      fi
      echo "$vt" | grep -q "^HF_TOKEN ok" || missing+=("Hugging Face token missing or rejected")
      echo "$vt" | grep -q "^GITHUB_TOKEN ok" || missing+=("GitHub token missing or rejected")
      grep -q '# >>> ashley' "$HOME/.bashrc" 2>/dev/null || missing+=("bashrc block missing (run the grid step again)")
      if [ $as_json -eq 1 ]; then
        printf '{"ok":%s,"missing":[' "$([ ${#missing[@]} -eq 0 ] && echo true || echo false)"; local first=1; for m in "${missing[@]}"; do [ $first -eq 1 ] || printf ','; first=0; json_str "$m"; done; echo ']}'
      else
        if [ ${#missing[@]} -eq 0 ]; then echo "eligible"; else echo "not eligible yet:"; printf '  - %s\n' "${missing[@]}"; fi
      fi
      [ ${#missing[@]} -eq 0 ];;
    request)
      local note=""; while [ $# -gt 0 ]; do case "$1" in --note) note="$2"; shift 2;; *) shift;; esac; done
      is_admin && { echo "you are the lab admin"; return 0; }
      local st; st=$(student_state)
      case "$st" in
        approved) echo "you already have lab access"; return 0;;
        filed|pending) echo "your request is already with your lead ($st)"; return 0;;
        denied|removed|approved_unreadable) die "your request was already decided ($st); ask your lead to reset it if you need to ask again";;
      esac
      cmd_access requirements >/dev/null || { cmd_access requirements; die "finish the setup first; requests are for working environments"; }
      [ -x "$BIN/access_request.sbatch" ] || { printf '#!/bin/bash\ntrue\n' > "$BIN/access_request.sbatch"; chmod 755 "$BIN/access_request.sbatch"; }
      note=$(sanitize_note "$note")
      local out; out=$(cd "$ASHLEY_HOME/log" 2>/dev/null || cd "$HOME"; sbatch --parsable --hold -J ashley_access -p reqp -q requeue -t 1 -n 1 --mem=16M -o /dev/null --comment "ashley-access v1 note=$note" "$BIN/access_request.sbatch" 2>&1) || die "could not file the request: $out"
      echo "request filed (held Slurm job ${out%%;*}; it never runs); your lead approves it in Ashley";;
    admin)
      is_admin || die "only the lab admin ($(access_admin)) can manage requests"
      local act="${1:-list}"; shift || true
      admin_ingest
      case "$act" in
        list)
          if [ "${1:-}" = "--json" ]; then
            printf '{"admin":%s,"requests":[' "$(json_str "$USER")"; local first=1 f
            for f in "$STATUS_DIR"/*.json; do [ -s "$f" ] || continue; [ $first -eq 1 ] || printf ','; first=0; tr -d '\n' < "$f"; done; echo ']}'
          else local f; for f in "$STATUS_DIR"/*.json; do [ -s "$f" ] && cat "$f"; done; fi;;
        approve|grant)
          local id="${1:?approve ID}"; getent passwd "$id" >/dev/null || die "no grid user $id"
          path_traverse "$id" add
          local fails=0; acl_grant "$id" || fails=$?
          write_status "$id" approved "$(status_field "$id" note)" "" "$(status_field "$id" requested)" "$(status_field "$id" job)"
          decision_log "$id" approved "failures=$fails"
          if [ "$fails" -gt 0 ]; then echo "$id approved, but $fails part(s) of the lab folder could not be opened (not owned by you?)"; else echo "$id approved: reads the lab folder $SHARED"; fi;;
        deny|remove)
          local id="${1:?$act ID}" msg=""; shift; while [ $# -gt 0 ]; do case "$1" in --message) msg="$2"; shift 2;; *) shift;; esac; done
          msg=$(sanitize_note "$msg")
          acl_revoke "$id"; path_traverse "$id" add
          write_status "$id" "$([ "$act" = deny ] && echo denied || echo removed)" "$(status_field "$id" note)" "$msg" "$(status_field "$id" requested)" "$(status_field "$id" job)"
          decision_log "$id" "$act" "$msg"; echo "$id ${act}${msg:+: $msg}";;
        reset)
          local id="${1:?reset ID}"; acl_revoke "$id"; path_traverse "$id" remove; rm -f "$(status_file "$id")"; decision_log "$id" reset ""; echo "$id reset: may request again";;
        resync)
          local u n=0; for u in $(approved_users); do acl_grant "$u" >/dev/null 2>&1; n=$((n + 1)); done; echo "re-applied lab access for $n approved user(s)";;
        *) die "access admin: list|approve ID|deny ID [--message ..]|remove ID [--message ..]|reset ID|resync";;
      esac;;
    *) die "access: init|whoami|status|requirements|request [--note ..]|admin ...";;
  esac
}

cmd_phone() { # phone access through Claude Code Remote Control, hosted by a worker (see phone.js)
  local sub="${1:-status}"; shift || true
  local worker="default" as_json=0
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; --json) as_json=1; shift;; *) shift;; esac; done
  [[ "$worker" =~ ^[A-Za-z0-9_-]+$ ]] || die "bad worker name"
  local w="$ASHLEY_HOME/workers/$worker" rc="$ASHLEY_HOME/workers/$worker/rc"
  [ -d "$w" ] || die "no worker '$worker' (start one first)"
  case "$sub" in
    on) mkdir -p "$rc" && chmod 700 "$rc" && rm -f "$rc/code" && touch "$rc/enable" && echo "phone access starting on worker $worker ($(cat "$w/node" 2>/dev/null || echo 'node not assigned yet'))";;
    off) rm -f "$rc/enable" "$rc/code"; echo "phone access off on worker $worker";;
    code)
      local c; c=$(head -c 4096 | tr -cd 'A-Za-z0-9_#.~-')
      [ -n "$c" ] || die "expected the code from the claude.ai page on stdin"
      ( umask 077; printf '%s\n' "$c" > "$rc/code.part" && mv "$rc/code.part" "$rc/code" ) && echo "code handed to worker $worker";;
    status)
      local alive=false; [ "$(job_state "$(cat "$w/job.id" 2>/dev/null)")" = RUNNING ] && alive=true
      if [ $as_json -eq 1 ]; then
        printf '{"worker":%s,"job_running":%s,"enabled":%s,"status":' "$(json_str "$worker")" "$alive" "$([ -e "$rc/enable" ] && echo true || echo false)"
        if [ -s "$rc/status.json" ]; then tr -d '\n' < "$rc/status.json"; else printf '{"phase":"off"}'; fi; echo '}'
      else echo "worker $worker running=$alive enabled=$([ -e "$rc/enable" ] && echo yes || echo no)"; cat "$rc/status.json" 2>/dev/null; fi;;
    *) die "phone: on|off|status|code [--worker NAME]";;
  esac
}

cmd_verify_tokens() { # prove the stored tokens work, from the login node (tiny requests); prints names, never values
  [ -s "$ASHLEY_HOME/secrets.env" ] || { echo "no secrets.env"; return 1; }
  unset HF_TOKEN GITHUB_TOKEN GH_TOKEN
  # shellcheck disable=SC1090
  source "$ASHLEY_HOME/secrets.env"
  if [ -n "${HF_TOKEN:-}" ]; then
    local who; who=$(curl_auth "$HF_TOKEN" https://huggingface.co/api/whoami-v2 | grep -o '"name":"[^"]*"' | head -1 | cut -d'"' -f4)
    [ -n "$who" ] && echo "HF_TOKEN ok ($who)" || echo "HF_TOKEN rejected or unreachable"
  else echo "HF_TOKEN missing"; fi
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    local gl; gl=$(curl_auth "$GITHUB_TOKEN" https://api.github.com/user | grep -o '"login": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    [ -n "$gl" ] && echo "GITHUB_TOKEN ok ($gl)" || echo "GITHUB_TOKEN rejected or unreachable"
  else echo "GITHUB_TOKEN missing"; fi
  # The subscription token (claude setup-token): one small authenticated request, no container needed.
  # 200 = a valid subscription token (setup-token only issues them to Pro/Max/Team/Enterprise);
  # 401 = invalid, expired or revoked; anything else = present but not confirmable right now.
  if [ -s "$ASHLEY_HOME/accounts/default/token" ]; then
    local ct code; ct=$(head -1 "$ASHLEY_HOME/accounts/default/token" | tr -d '\r\n')
    code=$(curl_auth_code "$ct" https://api.anthropic.com/v1/models "anthropic-beta: oauth-2025-04-20" "anthropic-version: 2023-06-01")
    case "$code" in
      200) echo "CLAUDE_TOKEN ok (subscription token accepted)";;
      401) echo "CLAUDE_TOKEN rejected (invalid, expired or revoked: run claude setup-token again)";;
      *) echo "CLAUDE_TOKEN present (the check answered HTTP $code)";;
    esac
  else echo "CLAUDE_TOKEN missing"; fi
}
cmd_uninstall() { # what a brand-new grid account looks like to Ashley
  local purge=0; [ "${1:-}" = "--purge-root" ] && purge=1
  load_cfg
  for w in $(worker_dirs); do local jid; jid=$(cat "$ASHLEY_HOME/workers/$w/job.id" 2>/dev/null || echo ""); [ -n "$jid" ] && scancel "$jid" 2>/dev/null && echo "cancelled worker $w (job $jid)"; done
  local rc="$HOME/.bashrc"
  if [ -f "$rc" ] && grep -q '# >>> ashley' "$rc"; then awk '/^# >>> ashley/{skip=1; next} /^# <<< ashley/{skip=0; next} skip==0{print}' "$rc" > "$rc.ashley.tmp" && mv "$rc.ashley.tmp" "$rc"; echo "bashrc block removed"; fi
  if [ $purge -eq 1 ] && [ -n "$ROOT" ] && [ -d "$ROOT" ]; then rm -rf "$ROOT" && echo "removed $ROOT"; fi
  # remove ourselves last; the shell keeps running the already-read script
  rm -rf "$ASHLEY_HOME" && echo "removed $ASHLEY_HOME; Ashley is uninstalled for $USER"
}

