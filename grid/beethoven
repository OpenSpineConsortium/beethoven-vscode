#!/bin/bash
# Beethoven for VS Code (c) 2026 OpenSpineConsortium. Licensed software: use requires a license key. See LICENSE.txt.
# beethoven: the grid-side command. Lives at ~/.beethoven/bin/beethoven; the laptop calls it over
# ssh, students can call it from a grid shell. Bash + coreutils only, so it works on the
# login node without any environment. Nothing heavy runs here: building the container and
# running Claude happen in Slurm jobs.
#
# Until 2026-09-30 the product was called Ashley, this command ashley and its folder ~/.ashley. The
# old names stay as links, made by `beethoven install`: ~/.ashley -> ~/.beethoven, bin/ashley ->
# beethoven and bin/ashleyd.js -> beethovend.js, because Ashley for VS Code 3.0.0, the browser
# edition's framework before 7 and worker job files written before this version still name them.
#
#   beethoven install [--root DIR]      layout, bashrc block, submit the bootstrap job
#   beethoven migrate                   ~/.ashley becomes ~/.beethoven (install does this by itself)
#   beethoven status [--json]           ready? jobs, workers, accounts, quota
#   beethoven doctor                    every check with a pass/fail line
#   beethoven worker start --name N [--hours 24 --cpus 4 --mem 16G --partition reqp --qos requeue --gpus 0 --concurrency 2]
#   beethoven worker stop|list|log|node [--name N] [--json] [--lines 80]
#   beethoven send --worker N --json    (JSON request on stdin)  -> prints "queued <id>"
#   beethoven wait [--worker N] [--timeout S] [--stream] <id>    -> result JSON (EVENT/RESULT lines with --stream)
#   beethoven ask  --worker N --json [--stream] [--timeout S]    (JSON request on stdin) = send + wait
#   beethoven result [--worker N] <id>
#   beethoven tail [--worker N] <id>
#   beethoven sessions [--json]
#   beethoven claude login|status|remote-consent      your Claude sign-in on the grid (Claude Code's own flow; never deleted or signed out)
#   beethoven accounts list|remove --yes                          your Claude sign-in; remove deletes an old API key (none used since grid scripts 8)
#   beethoven bootstrap [--resubmit] [--update]
#   beethoven uninstall --yes           what install put in place; your Claude sign-in, accounts, history and work folder stay
#   beethoven version
set -uo pipefail
# BEETHOVEN_HOME, else ASHLEY_HOME (its name before 2026-09-30, still set by older job files), else ~/.beethoven
BEETHOVEN_HOME="${BEETHOVEN_HOME:-${ASHLEY_HOME:-$HOME/.beethoven}}"
BIN="$BEETHOVEN_HOME/bin"
CFG="$BEETHOVEN_HOME/config.env"
VERSION=$(cat "$BIN/VERSION" 2>/dev/null || echo 0)
# The student's own Claude sign-in, stored by Claude Code itself (never read, copied or relayed by
# Beethoven): the CLAUDE_CONFIG_DIR of every Claude Code process Beethoven starts on the grid.
CLAUDE_HOME="$BEETHOVEN_HOME/claude"
die() { echo "beethoven: $*" >&2; exit 1; }
# A worker name and a request id become path segments under workers/ (inbox, outbox) and reach this
# script from the laptop's Claude through the MCP tools: one with a slash or a dot-dot would read or
# write outside the worker's folder, the Claude sign-in included. Checked before any path is built.
valid_worker() { [[ "${1:-}" =~ ^[A-Za-z0-9_-]+$ ]]; }
valid_id() { [[ "${1:-}" =~ ^[A-Za-z0-9_.-]+$ ]]; }   # always followed by .json or .events.jsonl
json_str() { # escape a string for JSON (control characters dropped)
  local s; s=$(printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037'); s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\r'/}; s=${s//$'\t'/\\t}; printf '"%s"' "$s"
}
# Destructive commands (uninstall, accounts remove) are for a person at a terminal. A Claude Code
# session (CLAUDECODE is set in every shell it runs) or a worker request must never remove the
# student's installation: on 2026-09-28 the whole grid folder (then ~/.ashley) vanished while a
# Remote Control session was open, with the sign-in inside it. Since grid scripts 9 no command here
# can delete a sign-in at all (see cmd_uninstall). A worker sets BEETHOVEN_REQUEST_ID and
# BEETHOVEN_WORKER in Claude's shell, and the ASHLEY_ twins for older readers.
refuse_destructive_from_agent() { # $1 what
  if [ -n "${CLAUDECODE:-}" ] || [ -n "${BEETHOVEN_REQUEST_ID:-}" ] || [ -n "${BEETHOVEN_WORKER:-}" ] || [ -n "${ASHLEY_REQUEST_ID:-}" ] || [ -n "${ASHLEY_WORKER:-}" ]; then
    die "refusing to $1 from inside a Claude Code session or worker: a person runs this at a terminal (beethoven $1 --yes)"
  fi
  [ -t 0 ] || die "refusing to $1 without a terminal: a person runs this (beethoven $1 --yes)"
}
load_cfg() { [ -s "$CFG" ] && source "$CFG"; ROOT="${ROOT:-}"; RUNTIME="${RUNTIME:-}"; SANDBOX="${SANDBOX:-}"; CLAUDE_BIN="${CLAUDE_BIN:-}"; BOOTSTRAP_JOB="${BOOTSTRAP_JOB:-}"; BINDS="${BINDS:-}"; CONTAINER="${CONTAINER:-}"; SOURCE="${SOURCE:-}"; }
is_ready() { load_cfg; [ -s "$BEETHOVEN_HOME/READY" ] && [ -n "$CLAUDE_BIN" ] && [ -x "$CLAUDE_BIN" ] && [ -x "$SANDBOX/usr/local/bin/node" ]; }
job_state() { # $1 job id -> state or "" if gone
  [ -n "${1:-}" ] || { echo ""; return; }
  local s; s=$(squeue -j "$1" -h -o %T 2>/dev/null | head -1)
  [ -n "$s" ] && { echo "$s"; return; }
  sacct -j "$1" -n -X -o State -P 2>/dev/null | head -1 | cut -d' ' -f1
}
set_cfg() { # KEY VALUE
  mkdir -p "$BEETHOVEN_HOME"; touch "$CFG"
  { grep -v -E "^$1=" "$CFG"; printf '%s=%q\n' "$1" "$2"; } > "$CFG.part" && mv "$CFG.part" "$CFG"; chmod 600 "$CFG"
}
default_root() {
  # a new account's work folder; an account set up before the rename keeps the ROOT its config.env names
  if [ -d "/rs/rs_grp_oschome/$USER" ] && [ -w "/rs/rs_grp_oschome/$USER" ]; then echo "/rs/rs_grp_oschome/$USER/beethoven"; else echo "$HOME/beethoven"; fi
}

# ---- the lab's shared container library -------------------------------------------------
# One group-readable tree on the CephFS volume holds pre-built containers with Claude Code
# inside. A student who can read it adopts an entry in a second instead of building for seven
# minutes and 1.8 GB. Containers are read-only at run time: every account's state lives in its
# own home, so sharing costs nothing in isolation.
# /rs/rs_grp_oschome/shared/ashley, its name before 2026-09-30, is a link to it (older builds name it)
LIBRARY_ROOT="${BEETHOVEN_LIBRARY:-${ASHLEY_LIBRARY:-/rs/rs_grp_oschome/shared/beethoven}}"
SHARED="$(dirname "$LIBRARY_ROOT")"      # the lab folder: students read it, never write it
ACCESS_ROOT="$SHARED/access"
lib_file() { echo "$LIBRARY_ROOT/library.json"; }
lib_readable() { [ -r "$(lib_file)" ]; }
# Readable is not approved: the lab's folder stays readable to every account the volume root lets in
# (hpcworker's shared copy lives there too), and the root also lets in an applicant whose request is pending,
# denied or removed (the pass-through to their status file). Their lead's decision rules; an account with no
# decision and a readable library is one the grid's own list let in.
lib_granted() {
  lib_readable || return 1
  case "$(status_field "$USER" state)" in pending|denied|removed) return 1;; esac
}
lib_field() { # NAME FIELD -> value (string fields only; python-free)
  local name="$1" field="$2"
  tr -d '\n' < "$(lib_file)" | grep -o "\"$name\": *{[^}]*}" | grep -o "\"$field\": *\"[^\"]*\"" | head -1 | sed 's/.*: *"\([^"]*\)"$/\1/'
}
lib_default() { tr -d '\n' < "$(lib_file)" | grep -o '"default": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/'; }
lib_names() { tr -d '\n' < "$(lib_file)" | grep -o '"containers": *{.*' | grep -o '"[A-Za-z0-9_.-]*": *{' | sed 's/"\([^"]*\)".*/\1/' | grep -v '^containers$'; }
cmd_library() {
  local sub="${1:-list}"; shift || true
  case "$sub" in
    list|--json)
      [ "$sub" = "--json" ] && set -- --json "$@"
      if ! lib_readable; then
        if [ "${1:-}" = "--json" ]; then echo '{"available":false,"root":"'"$LIBRARY_ROOT"'","containers":{}}'; else echo "no shared library readable at $LIBRARY_ROOT (ask your lead for the oschome group)"; fi; return 0
      fi
      if [ "${1:-}" = "--json" ]; then printf '{"available":true,"root":%s,"library":' "$(json_str "$LIBRARY_ROOT")"; tr -d '\n' < "$(lib_file)"; echo '}'
      else echo "shared library at $LIBRARY_ROOT (default: $(lib_default))"; for n in $(lib_names); do printf '  %-22s %s  [%s]%s\n' "$n" "$(lib_field "$n" purpose)" "$(lib_field "$n" claude_version)" "$([ "$(lib_field "$n" gpu)" = true ] && echo ' gpu' || true)"; done; fi;;
    publish)
      is_admin || die "only the lab admin publishes containers"
      # leads only: builds an entry as a job, then group-readable. beethoven library publish --name NAME --image docker://... [--gpu] [--purpose "..."] [--partition P --qos Q]
      local name="" image="docker://node:22-bookworm" gpu=0 purpose="" part="secp" qos="secondary"
      while [ $# -gt 0 ]; do case "$1" in --name) name="$2"; shift 2;; --image) image="$2"; shift 2;; --gpu) gpu=1; shift;; --purpose) purpose="$2"; shift 2;; --partition) part="$2"; shift 2;; --qos) qos="$2"; shift 2;; *) shift;; esac; done
      [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]] || die "library publish needs --name"
      mkdir -p "$LIBRARY_ROOT" "$BEETHOVEN_HOME/log" || die "cannot create $LIBRARY_ROOT"
      # the purpose travels in the environment (--export=ALL): inside --export a comma would cut it
      # group and other read, only the admin writes. Other is only who the volume root's list lets in (its
      # other::--- is the gate), and hpcworker's shared copy and the lab's image live in this folder too:
      # closing it to other shuts every student of the browser and desktop editions out (grid scripts 9)
      chmod 2755 "$LIBRARY_ROOT" 2>/dev/null
      local id; id=$(cd "$BEETHOVEN_HOME/log" && PURPOSE="$purpose" sbatch --parsable --partition="$part" --qos="$qos" --export="ALL,LIBRARY=1,ROOT_OVERRIDE=$LIBRARY_ROOT,LIB_NAME=$name,IMAGE=$image,GPU=$gpu" "$BIN/bootstrap.sbatch" 2>&1) || die "sbatch failed: $id"
      echo "publish job ${id%%;*} submitted: $name from $image into $LIBRARY_ROOT (log $BEETHOVEN_HOME/log/bootstrap_${id%%;*}.out)";;
    *) die "library: list|publish";;
  esac
}
cmd_adopt() { # use a shared container instead of building: writes config.env + READY
  local name="${1:-}"
  lib_readable || die "no shared library readable at $LIBRARY_ROOT"
  lib_granted || die "the lab's container comes with your lead's approval, and your lab access is $(status_field "$USER" state)"
  [ -n "$name" ] || name=$(lib_default)
  local sandbox claude runtime ver
  sandbox=$(lib_field "$name" sandbox); claude=$(lib_field "$name" claude_bin); runtime=$(lib_field "$name" runtime); ver=$(lib_field "$name" claude_version)
  [ -n "$sandbox" ] || die "no library entry '$name' (beethoven library)"
  [ -x "$sandbox/usr/local/bin/node" ] || die "cannot read the shared container $sandbox (ask your lead for the oschome group)"
  [ -r "$claude" ] || die "cannot read $claude"
  load_cfg; [ -n "$ROOT" ] || set_cfg ROOT "$(default_root)"; load_cfg
  mkdir -p "$ROOT/workspaces" 2>/dev/null
  [ -O "/rs/rs_grp_oschome/$USER" ] && chmod o-rwx "/rs/rs_grp_oschome/$USER"
  local binds="-B $HOME"; [ -d "/rs/rs_grp_oschome/$USER" ] && binds="$binds -B /rs/rs_grp_oschome/$USER"
  case "$ROOT" in "/rs/rs_grp_oschome/$USER"/*|"$HOME"/*) ;; *) binds="$binds -B $ROOT";; esac
  binds="$binds -B $SHARED"   # the lab folder (containers, datasets, software), read-only by permission
  set_cfg RUNTIME "$runtime"; set_cfg SANDBOX "$sandbox"; set_cfg CLAUDE_BIN "$claude"; set_cfg BINDS "$binds"; set_cfg CONTAINER "$name"; set_cfg SOURCE "shared"; set_cfg BOOTSTRAP_STATE "adopted"
  printf '{"claude_version":"%s","runtime":"%s","sandbox":"%s","container":"%s","source":"shared","adopted":"%s","host":"%s"}\n' "$ver" "$runtime" "$sandbox" "$name" "$(date -u +%FT%TZ)" "$(hostname)" > "$BEETHOVEN_HOME/READY.part" && mv "$BEETHOVEN_HOME/READY.part" "$BEETHOVEN_HOME/READY"
  echo "adopted shared container '$name' ($ver); nothing to build"
}

# ---- the rename: ~/.ashley becomes ~/.beethoven, the old names stay as links ---------------------
# The folder moves in one step (mv, then a relative link back), so the Claude sign-in, the license,
# the tokens and the workers' records move with it and nothing is entered again. Never a copy, never
# a deletion of a file. Only the default location moves: a folder named by BEETHOVEN_HOME or
# ASHLEY_HOME is left where it is.
OLD_HOME="$HOME/.ashley"; NEW_HOME="$HOME/.beethoven"
busy_workers() { # DIR: workers under DIR whose job is queued or running
  local w out=""; for w in "$1"/workers/*/; do [ -d "$w" ] || continue
    case "$(job_state "$(cat "$w/job.id" 2>/dev/null)")" in PENDING|RUNNING|CONFIGURING|COMPLETING|SUSPENDED) out="$out $(basename "$w")";; esac; done
  printf '%s' "$out"
}
migrate_home() { # [--merge]: 0 when ~/.beethoven is the folder and ~/.ashley leads to it
  local merge=0; [ "${1:-}" = --merge ] && merge=1
  [ "$BEETHOVEN_HOME" = "$NEW_HOME" ] || return 0
  if [ -L "$OLD_HOME" ]; then return 0; fi
  if [ ! -e "$OLD_HOME" ]; then   # a new account: the old name is made to lead here, for older builds
    mkdir -p "$NEW_HOME" && chmod 700 "$NEW_HOME" && ln -s .beethoven "$OLD_HOME"; return 0
  fi
  [ -d "$OLD_HOME" ] || die "$OLD_HOME exists and is not a folder; nothing moved"
  local busy; busy=$(busy_workers "$OLD_HOME")
  [ -z "$busy" ] || die "worker(s)$busy still run from ~/.ashley: stop them (beethoven worker stop --name NAME), then run this again; nothing moved"
  if [ ! -e "$NEW_HOME" ] && [ ! -L "$NEW_HOME" ]; then
    mv -T "$OLD_HOME" "$NEW_HOME" && ln -s .beethoven "$OLD_HOME" || die "could not move ~/.ashley to ~/.beethoven"
    echo "moved ~/.ashley to ~/.beethoven; ~/.ashley is now a link to it"
    return 0
  fi
  [ $merge = 1 ] || die "both ~/.ashley and ~/.beethoven are folders; nothing moved. Run: beethoven migrate (it moves the old folder's contents in and keeps the rest aside)"
  # both are folders: an installer made ~/.beethoven first (the new scripts and empty folders). The old
  # folder's contents move in; a name the new folder already holds with content stays in the old one,
  # which is then renamed aside (~/.ashley.before-beethoven.<time>), never deleted.
  local e b t kept="" aside
  for e in "$OLD_HOME"/* "$OLD_HOME"/.[!.]* "$OLD_HOME"/..?*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    b=$(basename "$e"); t="$NEW_HOME/$b"
    if [ "$b" = bin ]; then kept="$kept bin"; continue; fi   # the new scripts are already in place
    # an empty placeholder the installer made (folders only, no file inside) gives way, but never one of the
    # folders other tools keep here: a sign-in folder hpcworker or the engine made empty is still theirs
    case "$b" in claude|accounts|engine|projects) ;; *)
      if [ -d "$t" ] && [ ! -L "$t" ] && [ -z "$(find "$t" ! -type d -print -quit 2>/dev/null)" ]; then find "$t" -depth -type d -empty -delete 2>/dev/null; fi;;
    esac
    if [ ! -e "$t" ] && [ ! -L "$t" ]; then mv "$e" "$t" || kept="$kept $b"; else kept="$kept $b"; fi
  done
  aside="$HOME/.ashley.before-beethoven.$(date +%Y%m%d-%H%M%S)"
  mv -T "$OLD_HOME" "$aside" && ln -s .beethoven "$OLD_HOME" || die "could not rename ~/.ashley aside"
  echo "moved the contents of ~/.ashley into ~/.beethoven; ~/.ashley is now a link to it${kept:+ (left in $aside:$kept)}"
}
cmd_migrate() { migrate_home --merge; echo "grid folder: $NEW_HOME$([ -L "$OLD_HOME" ] && echo "; ~/.ashley -> $(readlink "$OLD_HOME")")"; }
old_names() { # the scripts' names before grid scripts 7, as links beside the new files
  # Ashley for VS Code 3.0.0 runs ~/.ashley/bin/ashley; worker job files written before 7 run bin/ashleyd.js
  ln -sfn beethoven "$BIN/ashley" && ln -sfn beethovend.js "$BIN/ashleyd.js"
}
# The ~/.bashrc block: markers "# >>> beethoven" and, before grid scripts 7, "# >>> ashley". Both are
# recognised, so an old block is replaced where it stands and never duplicated.
BASHRC_START='^# >>> (beethoven|ashley)'; BASHRC_END='^# <<< (beethoven|ashley)'
has_bashrc_block() { grep -Eq "$BASHRC_START" "${1:-$HOME/.bashrc}" 2>/dev/null; }
# A block is a start line and the next end line with no other start line between them. A start line with no
# end of its own (deleted or mistyped by hand) stays where it stands with every line after it: those are the
# student's (conda init, aliases), never ours to drop.
bashrc_without_blocks() { # FILE [BLOCK]: FILE without our blocks; with BLOCK, the first replaced by it where it stands (appended when none)
  awk -v s="$BASHRC_START" -v e="$BASHRC_END" -v blk="${2:-}" '
    NR == FNR { if ($0 ~ s) o = FNR; else if (o && $0 ~ e) { c[o] = 1; o = 0 }; next }
    !skip && (FNR in c) { skip = 1; if (blk != "" && !done) { while ((getline l < blk) > 0) print l; done = 1 }; next }
    skip { if ($0 ~ e) skip = 0; next }
    { print }
    END { if (blk != "" && !done) { print ""; while ((getline l < blk) > 0) print l } }' "$1" "$1"
}
bashrc_rewrite() { # FILE [BLOCK]: FILE through bashrc_without_blocks, written into the file a link leads to (the link stays)
  local real; real=$(readlink -f -- "$1") && [ -f "$real" ] || return 1
  bashrc_without_blocks "$real" "${2:-}" > "$real.beethoven.tmp" || { rm -f -- "$real.beethoven.tmp"; return 1; }
  chmod --reference="$real" "$real.beethoven.tmp" 2>/dev/null; mv -- "$real.beethoven.tmp" "$real"
}

cmd_install() {
  local root="" pass=() build_own=0
  while [ $# -gt 0 ]; do case "$1" in --root) root="$2"; shift 2;; --partition|--qos) pass+=("$1" "$2"); shift 2;; --build-own) build_own=1; shift;; *) shift;; esac; done
  migrate_home
  VERSION=$(cat "$BIN/VERSION" 2>/dev/null || echo "$VERSION")   # run from the old folder, the file is read again after the move
  mkdir -p "$BEETHOVEN_HOME"/{bin,log,accounts,workers,sessions} && chmod 700 "$BEETHOVEN_HOME" "$BEETHOVEN_HOME/accounts"
  retire_apikey
  # scripts uploaded from a Windows checkout may carry CR line endings, which break bash and sbatch
  # (links are skipped: sed -i would put a copy in a link's place)
  for f in "$BIN"/beethoven "$BIN"/*.sbatch "$BIN"/*.tpl "$BIN"/*.js "$BIN"/*.block "$BIN"/*.sh; do [ -f "$f" ] && [ ! -L "$f" ] && sed -i 's/\r$//' "$f"; done
  chmod +x "$BIN"/beethoven "$BIN"/*.sbatch "$BIN"/*.sh 2>/dev/null
  old_names || die "could not link the old names ashley and ashleyd.js in $BIN"
  load_cfg
  [ -n "$root" ] && set_cfg ROOT "$root"
  load_cfg; [ -n "$ROOT" ] || set_cfg ROOT "$(default_root)"
  load_cfg
  mkdir -p "$ROOT" 2>/dev/null || die "cannot create ROOT=$ROOT"
  # bashrc block (VS Code glibc sysroot + PATH), idempotent by markers: the first block (new or old
  # marker) is replaced where it stands, any further one is dropped, a start line without its end is kept
  local rc="$HOME/.bashrc" blk="$BIN/bashrc.block"
  touch "$rc"
  if has_bashrc_block "$rc"; then
    bashrc_rewrite "$rc" "$blk" || echo "note: could not rewrite $rc; its Beethoven block is as it was" >&2
  else
    { echo; cat "$blk"; } >> "$rc"
  fi
  echo "installed beethoven $VERSION at $BEETHOVEN_HOME (ROOT=$ROOT); bashrc block written"
  restart_old_workers
  if is_ready; then echo "grid already ready: $(cat "$BEETHOVEN_HOME/READY")"; return 0; fi
  # the shared library first: instant, consistent across the lab, no storage used
  if [ $build_own -eq 0 ] && lib_granted && cmd_adopt "$(lib_default)" 2>/dev/null; then return 0; fi
  # Not readable yet. When the lab runs access requests, the container arrives with access (the
  # wizard's last step): do not spend 1.8 GB and seven minutes of the student's space on a copy.
  if [ $build_own -eq 0 ] && lab_mode; then
    set_cfg AWAITING_ACCESS 1
    echo "the lab's shared container comes with lab access: request it as the wizard's last step (Beethoven: Lab access)"
    return 0
  fi
  cmd_bootstrap "${pass[@]}"
}

# A running worker keeps the daemon it started with (node holds it in memory) until its job ends, whatever
# was uploaded since. One from before grid scripts 9 moves Claude Code's transcripts inside the sign-in folder
# and runs on a sign-in with an API key behind it, so install restarts every running worker whose own
# heartbeat lacks "scripts" (beethovend.js writes it since 9) onto the scripts just installed; a request it
# had claimed is taken up again by the new daemon.
restart_old_workers() {
  local wk wd jid out
  for wk in $(worker_dirs); do wd="$BEETHOVEN_HOME/workers/$wk"; jid=$(cat "$wd/job.id" 2>/dev/null || echo "")
    [ -n "$jid" ] && [ -s "$wd/state.json" ] && grep -q "\"job\": *\"$jid\"" "$wd/state.json" || continue
    grep -q '"scripts":' "$wd/state.json" && continue
    [ "$(job_state "$jid")" = RUNNING ] || continue
    if out=$( ( cmd_worker restart --name "$wk" ) 2>&1 ); then echo "restarted worker $wk: it ran grid scripts older than $VERSION"
    else echo "worker $wk ran grid scripts older than $VERSION and was stopped, but did not start again ($(printf '%s' "$out" | tail -1)): start it again (Beethoven: Start a worker)" >&2; fi
  done
}

cmd_bootstrap() {
  # The bootstrap job defaults to reqp/requeue (the lab's CPU default). When that queue sits
  # PENDING (Priority) for long, --partition secp --qos secondary usually starts at once.
  local resubmit=0 update=0 part="" qos=""
  while [ $# -gt 0 ]; do case "$1" in --resubmit) resubmit=1; shift;; --update) update=1; shift;; --partition) part="$2"; shift 2;; --qos) qos="$2"; shift 2;; *) shift;; esac; done
  load_cfg
  if [ -n "$BOOTSTRAP_JOB" ] && [ $resubmit -eq 0 ] && [ $update -eq 0 ]; then
    local st; st=$(job_state "$BOOTSTRAP_JOB")
    case "$st" in PENDING|RUNNING|CONFIGURING|COMPLETING) echo "bootstrap job $BOOTSTRAP_JOB is $st"; return 0;; esac
  fi
  mkdir -p "$BEETHOVEN_HOME/log"
  local exp="ALL"; [ $update -eq 1 ] && exp="ALL,UPDATE=1"
  local extra=(); [ -n "$part" ] && extra+=(--partition="$part"); [ -n "$qos" ] && extra+=(--qos="$qos")
  local id; id=$(cd "$BEETHOVEN_HOME/log" && sbatch --parsable --export="$exp" "${extra[@]}" "$BIN/bootstrap.sbatch" 2>&1) || die "sbatch failed: $id"
  id=${id%%;*}
  set_cfg BOOTSTRAP_JOB "$id"; set_cfg BOOTSTRAP_STATE "submitted"
  echo "bootstrap job $id submitted (log: $BEETHOVEN_HOME/log/bootstrap_$id.out)"
}

home_quota() { # prints used_gb soft_gb or "0 0"
  local line; line=$(pan_quota 2>/dev/null | awk 'NR>2 && $1 ~ /^[0-9.]+$/ {print $1, $2; exit}')
  [ -n "$line" ] && { echo "$line"; return; }
  df -BG "$HOME" 2>/dev/null | awk 'NR==2 {gsub("G","",$3); gsub("G","",$2); print $3, $2}'
}

worker_dirs() { [ -d "$BEETHOVEN_HOME/workers" ] && for d in "$BEETHOVEN_HOME"/workers/*/; do [ -d "$d" ] && basename "$d"; done; }
worker_json() { # $1 name
  local w="$BEETHOVEN_HOME/workers/$1" jid st node alive="false" state="{}"
  jid=$(cat "$w/job.id" 2>/dev/null || echo ""); st=$(job_state "$jid"); node=$(cat "$w/node" 2>/dev/null || echo "")
  if [ -s "$w/state.json" ]; then state=$(tr -d '\n' < "$w/state.json"); fi
  if [ "$st" = "RUNNING" ] && [ -s "$w/state.json" ]; then
    local beat now; beat=$(stat -c %Y "$w/state.json" 2>/dev/null || echo 0); now=$(date +%s); [ $((now - beat)) -lt 90 ] && alive="true"
  fi
  local q; q=$(ls "$w/inbox" 2>/dev/null | grep -c '\.json$' || true)
  printf '{"name":%s,"job":%s,"job_state":%s,"node":%s,"alive":%s,"queued":%s,"state":%s}' "$(json_str "$1")" "$(json_str "$jid")" "$(json_str "${st:-none}")" "$(json_str "$node")" "$alive" "${q:-0}" "$state"
}
accounts_json() { # the sign-in (presence only); an API key is never an account (grid scripts 8)
  printf '['
  cooldown_of() { local c=""; [ -s "$1/state.json" ] && c=$(grep -o '"cooldown_until": *"[^"]*"' "$1/state.json" | head -1 | sed 's/.*"\([^"]*\)"$/\1/'); [ -n "$c" ] && printf '"%s"' "$c" || printf null; }
  if [ -s "$CLAUDE_HOME/.credentials.json" ]; then
    printf '{"name":"claude","kind":"login","enabled":%s,"cooldown_until":%s}' "$([ -e "$CLAUDE_HOME/disabled" ] && echo false || echo true)" "$(cooldown_of "$CLAUDE_HOME")"
  fi
  printf ']'
}
secrets_json() { # names (never values) of the variables in secrets.env
  local first=1; printf '['
  if [ -s "$BEETHOVEN_HOME/secrets.env" ]; then
    while IFS='=' read -r k _; do [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue; [ $first -eq 1 ] || printf ','; first=0; printf '"%s"' "$k"; done < "$BEETHOVEN_HOME/secrets.env"
  fi; printf ']'
}
jobs_json() {
  local first=1; printf '['
  while IFS='|' read -r i j t n m l p r; do
    [ -n "$i" ] || continue; [ $first -eq 1 ] || printf ','; first=0
    printf '{"jobId":%s,"name":%s,"state":%s,"node":%s,"elapsed":%s,"timeLimit":%s,"partition":%s,"reason":%s}' "$(json_str "$i")" "$(json_str "$j")" "$(json_str "$t")" "$(json_str "$n")" "$(json_str "$m")" "$(json_str "$l")" "$(json_str "$p")" "$(json_str "$r")"
  done < <(squeue -u "$USER" -h -o '%i|%j|%T|%N|%M|%l|%P|%R' 2>/dev/null); printf ']'
}
license_fp() { # first 16 hex digits of the license key's SHA-256 (the laptop compares it with its own)
  [ -s "$BEETHOVEN_HOME/license.key" ] || return 0
  tr -d '\r\n' < "$BEETHOVEN_HOME/license.key" | sha256sum | cut -c1-16
}
cmd_status() {
  local as_json=0; [ "${1:-}" = "--json" ] && as_json=1
  load_cfg
  if ! is_ready && lib_granted; then ( cmd_adopt "$(lib_default)" ) >/dev/null 2>&1; load_cfg; fi
  local ready=false cv="" bst=""
  is_ready && ready=true
  [ -s "$BEETHOVEN_HOME/READY" ] && cv=$(grep -o '"claude_version":"[^"]*"' "$BEETHOVEN_HOME/READY" | cut -d'"' -f4)
  [ -n "$BOOTSTRAP_JOB" ] && bst=$(job_state "$BOOTSTRAP_JOB")
  read -r used soft < <(home_quota)
  if [ $as_json -eq 1 ]; then
    local awaiting=false
    case "$bst" in PENDING|RUNNING|CONFIGURING) ;; *) if [ "$ready" = false ] && ! lib_granted && lab_mode; then awaiting=true; fi;; esac
    printf '{"version":%s,"host":%s,"ready":%s,"awaiting_access":%s,"root":%s,"runtime":%s,"claude_version":%s,"container":%s,"source":%s,"library":%s,"bootstrap_job":%s,"bootstrap_state":%s,"home_used_gb":%s,"home_soft_gb":%s,"workers":[' \
      "$(json_str "$VERSION")" "$(json_str "$(hostname)")" "$ready" "$awaiting" "$(json_str "$ROOT")" "$(json_str "$RUNTIME")" "$(json_str "$cv")" "$(json_str "${CONTAINER:-own}")" "$(json_str "${SOURCE:-own}")" "$(lib_readable && echo true || echo false)" "$(json_str "$BOOTSTRAP_JOB")" "$(json_str "$bst")" "${used:-0}" "${soft:-0}"
    local first=1; for w in $(worker_dirs); do [ $first -eq 1 ] || printf ','; first=0; worker_json "$w"; done
    printf '],"accounts":%s,"secrets":%s,"jobs":%s,"license":%s,"claude_login":%s,"claude_dir":%s}\n' "$(accounts_json)" "$(secrets_json)" "$(jobs_json)" "$(json_str "$(license_fp)")" "$(claude_login_json)" "$([ -s "$CLAUDE_HOME/.credentials.json" ] && echo true || echo false)"
  else
    echo "beethoven $VERSION on $(hostname)  ready=$ready  claude=${cv:-?}  root=${ROOT:-?}"
    [ -n "$BOOTSTRAP_JOB" ] && echo "bootstrap job $BOOTSTRAP_JOB: ${bst:-finished}"
    echo "home: ${used:-?} GB used of ${soft:-?} GB soft quota"
    echo "accounts: $(accounts_json)"
    echo "workers:"; for w in $(worker_dirs); do echo "  $(worker_json "$w")"; done
    echo "jobs:"; squeue -u "$USER" -o '%.10i %.18j %.9T %.12N %.10M %.11l %.8P %R' 2>/dev/null
  fi
}

cmd_doctor() {
  load_cfg; local fail=0
  ok() { echo "PASS  $*"; }; bad() { echo "FAIL  $*"; fail=1; }
  [ -x "$BIN/beethoven" ] && ok "beethoven $VERSION installed at $BIN" || bad "beethoven not executable"
  { [ -L "$BIN/ashley" ] && [ -L "$BIN/ashleyd.js" ]; } && ok "the old names ashley and ashleyd.js lead to the new files" || bad "the links ashley and ashleyd.js are missing: run beethoven install"
  if [ "$BEETHOVEN_HOME" = "$NEW_HOME" ]; then [ -L "$OLD_HOME" ] && ok "~/.ashley leads to ~/.beethoven" || bad "~/.ashley is not a link to ~/.beethoven: run beethoven install"; fi
  has_bashrc_block && ok "bashrc block present (VS Code glibc sysroot, PATH)" || bad "bashrc block missing: run beethoven install"
  for f in /wsu/apps/vscode/sysroot/x86_64-linux-gnu/x86_64-linux-gnu/sysroot/lib/ld-linux-x86-64.so.2 /wsu/apps/vscode/patchelf/0.19.1/bin/patchelf; do [ -e "$f" ] && ok "C&IT VS Code sysroot: $f" || bad "missing $f (C&IT moved the sysroot?)"; done
  [ -n "$ROOT" ] && [ -w "$ROOT" ] && ok "ROOT $ROOT writable" || bad "ROOT not writable (${ROOT:-unset})"
  if is_ready; then ok "READY: $(cat "$BEETHOVEN_HOME/READY")"; else bad "not ready (bootstrap job ${BOOTSTRAP_JOB:-none}: $(job_state "$BOOTSTRAP_JOB"))"; fi
  [ -n "$RUNTIME" ] && [ -x "$RUNTIME" ] && ok "runtime $RUNTIME" || bad "runtime missing on this host (fine on the login node if the compute nodes have it)"
  local lj; lj=$(claude_login_json)
  if claude_login_other "$lj"; then bad "Claude on the grid is signed in, but not with a Claude subscription; Beethoven runs only on your own subscription (beethoven claude login)"
  elif [ -s "$CLAUDE_HOME/.credentials.json" ]; then ok "Claude signed in on the grid (Claude Code's own store in $CLAUDE_HOME)$(claude_login_old_rule "$lj" && echo "; a worker started before grid scripts 9 does not yet look for an API key behind the sign-in: restart it")"; else bad "Claude not signed in on the grid (beethoven claude login)"; fi
  [ -s "$BEETHOVEN_HOME/secrets.env" ] && ok "secrets.env present ($(stat -c %a "$BEETHOVEN_HOME/secrets.env")): $(cmd_verify_tokens 2>/dev/null | tr '\n' ';')" || bad "secrets.env missing (GitHub / Hugging Face tokens for the worker)"
  read -r used soft < <(home_quota); ok "home quota ${used:-?}/${soft:-?} GB"
  for w in $(worker_dirs); do echo "      worker $(worker_json "$w")"; done
  [ $fail -eq 0 ] && echo "doctor: all checks passed" || echo "doctor: some checks failed"
  return $fail
}

cmd_worker() {
  local sub="${1:-list}"; shift || true
  local name="default" hours=24 cpus=4 mem="16G" part="reqp" qos="requeue" gpus=0 conc=2 lines=80 as_json=0 container=""
  while [ $# -gt 0 ]; do case "$1" in
    --name) name="$2"; shift 2;; --hours) hours="$2"; shift 2;; --cpus) cpus="$2"; shift 2;; --mem) mem="$2"; shift 2;;
    --partition) part="$2"; shift 2;; --qos) qos="$2"; shift 2;; --gpus) gpus="$2"; shift 2;; --concurrency) conc="$2"; shift 2;;
    --container) container="$2"; shift 2;;
    --lines) lines="$2"; shift 2;; --json) as_json=1; shift;; *) shift;; esac; done
  valid_worker "$name" || die "worker name must be letters, digits, _ or -"
  local w="$BEETHOVEN_HOME/workers/$name"
  case "$sub" in
    start)
      # access granted since the last install: adopt the lab's container on the spot
      if ! is_ready && lib_granted; then ( cmd_adopt "$(lib_default)" ) >/dev/null 2>&1; load_cfg; fi
      if ! is_ready && ! lib_granted && lab_mode; then die "no container yet: it comes with lab access (the last setup step; your lead approves it)"; fi
      is_ready || die "grid not ready yet (bootstrap job ${BOOTSTRAP_JOB:-none}: $(job_state "${BOOTSTRAP_JOB:-}")); try again when 'beethoven status' says ready=true"
      # the lab's container stays readable after a lead denies or removes access; the decision still holds
      [ "${SOURCE:-}" != shared ] || lib_granted || die "your lab access is $(status_field "$USER" state), and the lab's container comes with it: ask your lead"
      [ -s "$BEETHOVEN_HOME/license.key" ] || die "no Beethoven license on the grid yet: run the setup's grid step in VS Code (it copies your license here)"
      mkdir -p "$w"/{inbox,outbox,log}
      rm -f "$w/stop"
      retire_apikey
      local jid st; jid=$(cat "$w/job.id" 2>/dev/null || echo ""); st=$(job_state "$jid")
      case "$st" in PENDING|RUNNING|CONFIGURING) echo "worker $name already has job $jid ($st) on $(cat "$w/node" 2>/dev/null || echo '?')"; return 0;; esac
      [[ "$hours" =~ ^[0-9]+$ ]] || die "--hours must be an integer"
      # every value below is written into the job script by sed and runs in the job's shell
      [[ "$cpus" =~ ^[0-9]+$ ]] || die "--cpus must be an integer"
      [[ "$gpus" =~ ^[0-9]+$ ]] || die "--gpus must be an integer"
      [[ "$conc" =~ ^[0-9]+$ ]] || die "--concurrency must be an integer"
      [[ "$mem" =~ ^[0-9]+[KMGTkmgt]?$ ]] || die "--mem must be a number with an optional K, M, G or T"
      [[ "$part" =~ ^[A-Za-z0-9_-]+(,[A-Za-z0-9_-]+)*$ ]] || die "--partition must be partition names separated by commas"
      [[ "$qos" =~ ^[A-Za-z0-9_-]+$ ]] || die "--qos must be letters, digits, _ or -"
      [ -z "$container" ] || [[ "$container" =~ ^[A-Za-z0-9_.-]+$ ]] || die "--container must be a library name (beethoven library)"
      local time; time=$(printf '%d-%02d:00:00' $((hours / 24)) $((hours % 24)))
      local gres="" requeue="#SBATCH --no-requeue" w_sandbox="" w_claude=""
      [ "$gpus" != "0" ] && gres="#SBATCH --gres=gpu:$gpus"
      [ "$qos" = "requeue" ] && requeue="#SBATCH --requeue"
      if [ -n "$container" ]; then
        lib_readable || die "--container needs the shared library ($LIBRARY_ROOT)"
        w_sandbox=$(lib_field "$container" sandbox); w_claude=$(lib_field "$container" claude_bin)
        [ -n "$w_sandbox" ] || die "no library entry '$container' (beethoven library)"
        [ -x "$w_sandbox/usr/local/bin/node" ] || die "cannot read the shared container $w_sandbox"
        echo "$container" > "$w/container"
      fi
      # remember the settings, so a restart re-renders the job from the CURRENT template (upgrades apply)
      printf '%s\n' --hours "$hours" --cpus "$cpus" --mem "$mem" --partition "$part" --qos "$qos" --gpus "$gpus" --concurrency "$conc" ${container:+--container "$container"} > "$w/params"
      sed -e "s|@NAME@|$name|g" -e "s|@PARTITION@|$part|g" -e "s|@QOS@|$qos|g" -e "s|@CPUS@|$cpus|g" -e "s|@MEM@|$mem|g" \
          -e "s|@TIME@|$time|g" -e "s|@GRES@|$gres|g" -e "s|@REQUEUE@|$requeue|g" -e "s|@GPUS@|$gpus|g" -e "s|@CONC@|$conc|g" \
          -e "s|@SANDBOX@|$w_sandbox|g" -e "s|@CLAUDE_BIN@|$w_claude|g" -e "s|@LIBRARY@|$SHARED|g" \
          "$BIN/worker.sbatch.tpl" > "$w/job.sbatch.part" && mv "$w/job.sbatch.part" "$w/job.sbatch" || die "could not write the job script"
      local out; out=$(cd "$w" && sbatch --parsable job.sbatch 2>&1) || die "sbatch failed: $out"
      jid=${out%%;*}; echo "$jid" > "$w/job.id"; rm -f "$w/node"
      echo "submitted worker $name as job $jid ($part/$qos, $cpus cpu, $mem, $time, gpus=$gpus, concurrency=$conc${container:+, container $container})";;
    restart) # stop, re-render the job from the current template with the saved settings, submit again
      local oj; oj=$(cat "$w/job.id" 2>/dev/null || echo ""); [ -n "$oj" ] && scancel "$oj" 2>/dev/null
      rm -f "$w/stop" "$w/node" "$w/job.id"; sleep 2
      if [ -s "$w/params" ]; then
        local -a saved; mapfile -t saved < "$w/params"
        cmd_worker start --name "$name" "${saved[@]}"
      else
        [ -s "$w/job.sbatch" ] || die "worker $name has no job script to restart"
        local nj; nj=$(cd "$w" && sbatch --parsable job.sbatch 2>&1) || die "sbatch failed: $nj"
        echo "${nj%%;*}" > "$w/job.id"; echo "restarted worker $name as job ${nj%%;*} with its old job script (start it once with beethoven worker start to pick up a newer template)"
      fi;;
    stop)
      [ -d "$w" ] || die "no worker $name"
      touch "$w/stop"
      local jid; jid=$(cat "$w/job.id" 2>/dev/null || echo "")
      [ -n "$jid" ] && scancel "$jid" 2>/dev/null
      echo "worker $name stopped (job ${jid:-none} cancelled)";;
    list)
      if [ $as_json -eq 1 ]; then printf '{"workers":['; local first=1; for x in $(worker_dirs); do [ $first -eq 1 ] || printf ','; first=0; worker_json "$x"; done; printf ']}\n'
      else for x in $(worker_dirs); do worker_json "$x"; echo; done; fi;;
    log)
      [ -d "$w" ] || die "no worker $name"
      # beethovend.log; a worker started before grid scripts 7 writes ashleyd.log
      local dl="$w/log/beethovend.log"; [ -s "$dl" ] || [ ! -s "$w/log/ashleyd.log" ] || dl="$w/log/ashleyd.log"
      echo "--- $(basename "$dl")"; tail -n "$lines" "$dl" 2>/dev/null
      echo "--- slurm"; ls -t "$w"/log/slurm_*.out 2>/dev/null | head -1 | xargs -r tail -n 40;;
    node)
      [ -s "$w/node" ] || die "worker $name has no node yet ($(job_state "$(cat "$w/job.id" 2>/dev/null)"))"
      cat "$w/node";;
    *) die "worker: start|stop|list|log|node";;
  esac
}

# ---- requests ---------------------------------------------------------------------------
req_id_from_stdin() { # reads JSON on stdin into $REQ, extracts id
  REQ=$(cat); [ -n "$REQ" ] || die "expected a JSON request on stdin"
  RID=$(printf '%s' "$REQ" | grep -o '"id": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
  valid_id "$RID" || die "request JSON needs an id"
}
enqueue() { # $1 worker; uses REQ/RID; prints the queued line
  local worker="$1" w="$BEETHOVEN_HOME/workers/$1"
  valid_worker "$worker" || die "worker name must be letters, digits, _ or -"
  [ -d "$w" ] || die "no worker '$worker' (beethoven worker start --name $worker)"
  mkdir -p "$w/inbox" "$w/outbox"
  printf '%s' "$REQ" > "$w/inbox/$RID.json.part" && mv "$w/inbox/$RID.json.part" "$w/inbox/$RID.json"
  local jid st n; jid=$(cat "$w/job.id" 2>/dev/null || echo ""); st=$(job_state "$jid"); n=$(ls "$w/inbox" 2>/dev/null | grep -c '\.json$' || true)
  echo "queued $RID on worker $worker (job ${jid:-none} ${st:-not running}; ${n:-0} waiting)"
}
cmd_send() {
  local worker="default"
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; *) shift;; esac; done
  req_id_from_stdin
  enqueue "$worker"
}
cmd_wait() {
  local worker="default" timeout=3600 stream=0 id=""
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; --timeout) timeout="$2"; shift 2;; --stream) stream=1; shift;; --json) shift;; *) id="$1"; shift;; esac; done
  valid_id "$id" || die "wait: request id required"
  valid_worker "$worker" || die "worker name must be letters, digits, _ or -"
  local w="$BEETHOVEN_HOME/workers/$worker" out="$BEETHOVEN_HOME/workers/$worker/outbox/$id.json" ev="$BEETHOVEN_HOME/workers/$worker/outbox/$id.events.jsonl"
  local start; start=$(date +%s); local off=0
  while :; do
    if [ $stream -eq 1 ] && [ -f "$ev" ]; then
      local size; size=$(stat -c %s "$ev" 2>/dev/null || echo 0)
      if [ "$size" -gt "$off" ]; then tail -c +$((off + 1)) "$ev" | head -c $((size - off)) | sed 's/^/EVENT /'; off=$size; fi
    fi
    if [ -s "$out" ]; then
      if [ $stream -eq 1 ]; then printf 'RESULT '; tr -d '\n' < "$out"; echo; else cat "$out"; fi
      return 0
    fi
    if [ $(( $(date +%s) - start )) -ge "$timeout" ]; then
      [ $stream -eq 1 ] && echo "TIMEOUT $id"
      echo "beethoven: no result for $id after ${timeout}s (worker job $(cat "$w/job.id" 2>/dev/null) $(job_state "$(cat "$w/job.id" 2>/dev/null)"))" >&2; return 124
    fi
    sleep 0.5
  done
}
cmd_ask() {
  local worker="default" timeout=3600 stream=""
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; --timeout) timeout="$2"; shift 2;; --stream) stream="--stream"; shift;; *) shift;; esac; done
  req_id_from_stdin
  local msg; msg=$(enqueue "$worker") || exit 1
  [ -n "$stream" ] && echo "QUEUED $msg"
  # shellcheck disable=SC2086
  cmd_wait --worker "$worker" --timeout "$timeout" $stream "$RID"
}
cmd_result() {
  local worker="default" id=""
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; *) id="$1"; shift;; esac; done
  valid_worker "$worker" || die "worker name must be letters, digits, _ or -"
  valid_id "$id" || die "result: request id must be letters, digits, _, . or -"
  local f="$BEETHOVEN_HOME/workers/$worker/outbox/$id.json"; [ -s "$f" ] || { echo "no result yet for $id" >&2; exit 1; }; cat "$f"
}
cmd_tail() {
  local worker="default" id=""
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; *) id="$1"; shift;; esac; done
  valid_worker "$worker" || die "worker name must be letters, digits, _ or -"
  valid_id "$id" || die "tail: request id must be letters, digits, _, . or -"
  tail -n 50 -f "$BEETHOVEN_HOME/workers/$worker/outbox/$id.events.jsonl"
}
cmd_sessions() {
  local as_json=0; [ "${1:-}" = "--json" ] && as_json=1
  if [ $as_json -eq 1 ]; then printf '{"sessions":['; local first=1; for f in "$BEETHOVEN_HOME"/sessions/*.json; do [ -s "$f" ] || continue; [ $first -eq 1 ] || printf ','; first=0; tr -d '\n' < "$f"; done; printf ']}\n'
  else for f in "$BEETHOVEN_HOME"/sessions/*.json; do [ -s "$f" ] && { basename "$f" .json; sed 's/^/    /' "$f"; }; done; fi
}
# Up to grid scripts 8 the sign-in folder's projects/ was turned into a link to ~/.beethoven/projects, its
# transcripts moved out first, so a request moved to the API key account could resume there. There is one
# account now, and nothing of ours moves or renames anything inside a sign-in folder: a link made then
# stays (the sessions kept behind it still resume), and a projects/ folder Claude Code made stays its own.
# The Anthropic API key overflow (add-key and its switches, up to grid scripts 7) is gone: it was paid
# usage beyond the student's subscription, which the maintainer ruled out for everyone on 2026-10-04.
# The key is not read from stdin, so a laptop of 4.0.0 that still pipes one gets a refusal and stores nothing.
# A key stored before is never used and never deleted by Beethoven; only `accounts remove --yes` removes it.
# A worker started under grid scripts 7 keeps its old daemon until its job ends, and that daemon reads the
# key on every request; the `disabled` marker beside it is the one switch it honours, so every install,
# worker start and repair sets it. The marker deletes nothing and the key stays the student's.
retire_apikey() {
  local d="$BEETHOVEN_HOME/accounts/apikey"
  [ -e "$d/apikey" ] && [ ! -e "$d/disabled" ] && touch "$d/disabled"
  return 0
}
cmd_accounts() {
  local sub="${1:-list}" d="$BEETHOVEN_HOME/accounts/apikey"
  case "$sub" in
    list) accounts_json; echo;;
    add-token) die "Beethoven no longer stores Claude tokens. Sign in on the grid through Claude Code's own flow: beethoven claude login";;
    add-key|enable|disable) die "Beethoven no longer uses an Anthropic API key: your worker runs only on your own Claude subscription and, when its window is spent, answers with the time it resets. A key an earlier version stored is never used; beethoven accounts remove --yes deletes it.";;
    remove) # the student's own deliberate step; the key file only, never a link or a folder (accounts/ is also
      # where the engine keeps the student's other sign-ins, and a label may be any word, apikey included)
      [ "${2:-}" = "--yes" ] || die "this deletes the API key an earlier version stored in $d (Beethoven never uses it; revoke the key itself in your Anthropic Console): beethoven accounts remove --yes"
      refuse_destructive_from_agent "accounts remove"
      [ -f "$d/apikey" ] && [ ! -L "$d/apikey" ] || die "no API key is stored"
      rm -f "$d/apikey"; echo "removed $d/apikey";;
    *) die "accounts: list|remove --yes";;
  esac
}

# ---- your Claude sign-in on the grid: Claude Code's own flow, in your allocation -----------------
claude_in_alloc() { # run Claude Code interactively inside the container, in a running worker's allocation or a short one
  load_cfg; is_ready || die "the lab container is not adopted yet (lab access is the step before this)"
  local jid="" wk; for wk in $(worker_dirs); do local j; j=$(cat "$BEETHOVEN_HOME/workers/$wk/job.id" 2>/dev/null); [ "$(job_state "$j")" = RUNNING ] && { jid=$j; break; }; done
  local cwd="$ROOT/workspaces/phone"; mkdir -p "$cwd" "$CLAUDE_HOME"; chmod 700 "$CLAUDE_HOME"
  # first-run settings so Claude Code asks no onboarding questions in the terminal (settings, not credentials):
  # the three keys only added when missing, nothing written when they are there, and a file that does not parse
  # (Claude Code writing it, or damaged) left as it is (hpcworker's seed; seedClaudeJson in phone.js)
  # shellcheck disable=SC2016
  local seed='const fs=require("fs"),p=process.env.CLAUDE_CONFIG_DIR+"/.claude.json",no=function(){console.error("Claude Code settings file "+p+" could not be read; Beethoven left it as it is");process.exit(0)};let j={};try{j=JSON.parse(fs.readFileSync(p,"utf8"))}catch(e){if(!e||e.code!=="ENOENT")no()}if(!j||typeof j!=="object"||Array.isArray(j))no();let ch=false;if(j.hasCompletedOnboarding!==true){j.hasCompletedOnboarding=true;ch=true}if(!j.theme){j.theme="dark";ch=true}j.projects=j.projects||{};const d=process.cwd(),pr=j.projects[d]||{};if(pr.hasTrustDialogAccepted!==true){j.projects[d]=Object.assign({},pr,{hasTrustDialogAccepted:true});ch=true}if(ch){fs.writeFileSync(p+".part",JSON.stringify(j,null,1),{mode:0o600});fs.renameSync(p+".part",p)}'
  local inner="cd '$cwd' && node -e '$seed' && exec '$CLAUDE_BIN' $*"
  # a sign-in is judged in the same session, before anything else runs on it: exit 4 when it is not the
  # student's Claude subscription (signin_kind, this file run inside the container)
  [ "$*" = "auth login" ] && inner="cd '$cwd' && node -e '$seed' && '$CLAUDE_BIN' auth login && { [ \"\$('$CLAUDE_BIN' auth status 2>/dev/null | bash '$BIN/beethoven' signin-kind)\" != other ] || exit 4; }"
  # every variable that would put Claude Code on a key, a token, a gateway or a cloud provider instead of
  # the sign-in it keeps: hpcworker's list (CLEAN_ENV in its worker template, framework 17), the same in
  # beethovend.js and phone.js (AUTH_VARS), login_relay.sh and the laptop's CLAUDE_CREDENTIAL_ENV; a test
  # compares the five. The two Remote Control switches after it are not credentials, and removed here too.
  local auth_unset=(-u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_BASE_URL -u CLAUDE_CODE_OAUTH_TOKEN -u CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR -u CLAUDE_CODE_API_KEY_FILE_DESCRIPTOR -u CLAUDE_CODE_USE_BEDROCK -u CLAUDE_CODE_USE_VERTEX -u CLAUDE_CODE_USE_FOUNDRY -u CLAUDE_CODE_USE_ANTHROPIC_AWS -u CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD -u CLAUDE_CODE_USE_MANTLE -u CLAUDE_CODE_USE_GATEWAY -u CLAUDE_CODE_OAUTH_REFRESH_TOKEN -u CLAUDE_CODE_OAUTH_SCOPES)
  # shellcheck disable=SC2086
  if [ -n "$jid" ]; then
    srun --jobid="$jid" --overlap -N1 -n1 --pty "$RUNTIME" exec $BINDS "$SANDBOX" env "${auth_unset[@]}" -u CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC -u DISABLE_GROWTHBOOK HOME="$HOME" CLAUDE_CONFIG_DIR="$CLAUDE_HOME" TERM="${TERM:-xterm-256color}" BROWSER=/bin/false bash -c "$inner"
  else
    echo "(no worker is running: asking Slurm for a short session on a compute node; this can take a minute)"
    srun -p secp -q secondary -t 00:30:00 -N1 -n1 --mem=2G -J beethoven_claude --pty "$RUNTIME" exec $BINDS "$SANDBOX" env "${auth_unset[@]}" -u CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC -u DISABLE_GROWTHBOOK HOME="$HOME" CLAUDE_CONFIG_DIR="$CLAUDE_HOME" TERM="${TERM:-xterm-256color}" BROWSER=/bin/false bash -c "$inner"
  fi
}
signin_kind() { # stdin: what `claude auth status` printed -> subscription | other | none
  # hpcworker's rule (hpcw_claude_signin in its common.sh): loggedIn true, authMethod "claude.ai",
  # apiProvider "firstParty" or absent, and no apiKeySource. apiKeySource is there only when a key is behind
  # the sign-in, and Claude Code reports the Console's own key as authMethod "claude.ai" beside it, so its
  # presence alone decides; its value is not read. Four keys are read and nothing else.
  local t li am ap; t=$(tr -d '\n')
  li=$(printf '%s' "$t" | grep -o '"loggedIn": *\(true\|false\)' | head -1 | grep -o 'true\|false')
  [ "$li" = true ] || { echo none; return 0; }
  printf '%s' "$t" | grep -q '"apiKeySource":' && { echo other; return 0; }
  am=$(printf '%s' "$t" | grep -o '"authMethod": *"[^"]*"' | head -1 | cut -d'"' -f4)
  ap=$(printf '%s' "$t" | grep -o '"apiProvider": *"[^"]*"' | head -1 | cut -d'"' -f4)
  if [ "$am" = claude.ai ] && { [ -z "$ap" ] || [ "$ap" = firstParty ]; }; then echo subscription; else echo other; fi
}
# The student's answer to Claude Code's one-time Remote Control question, when Claude Code has not
# recorded it itself: .beethoven-remote-consent, and .ashley-remote-consent (its name before grid
# scripts 7), which the browser edition's framework before 7 reads. Both are written, either counts.
CONSENT_MARKERS=("$CLAUDE_HOME/.beethoven-remote-consent" "$CLAUDE_HOME/.ashley-remote-consent")
consent_given() { # the student answered Claude Code's one-time Remote Control question (Claude Code's own record, or Beethoven's marker)
  local m; for m in "${CONSENT_MARKERS[@]}"; do [ -e "$m" ] && return 0; done
  grep -q '"remoteDialogSeen": *true' "$CLAUDE_HOME/.claude.json" 2>/dev/null
}
claude_login_json() { # what the newest running worker's Claude Code said about the sign-in (heartbeat), or null
  local wk best="" bt=0; for wk in $(worker_dirs); do local wd="$BEETHOVEN_HOME/workers/$wk"
    [ "$(job_state "$(cat "$wd/job.id" 2>/dev/null)")" = RUNNING ] || continue
    local m; m=$(stat -c %Y "$wd/state.json" 2>/dev/null || echo 0); [ "$m" -gt "$bt" ] && { bt=$m; best="$wd"; }; done
  [ -n "$best" ] && tr -d '\n' < "$best/state.json" | grep -o '"claude_login": *{[^}]*}' | sed 's/^"claude_login": *//' | head -1 | grep . || echo null
}
# only a Claude subscription counts: a sign-in through an API key, a token or a cloud provider gets no
# work (beethovend.js); a heartbeat without the subscription field (a daemon from before it) is not judged here
claude_login_other() { # $1 what claude_login_json printed -> true when signed in, but not with a subscription
  echo "$1" | grep '"loggedIn": *true' | grep -E '"subscription": *false|"apiKey": *true' >/dev/null
}
# a daemon of grid scripts 8 or older judges the sign-in without looking for a key behind it (apiKeySource);
# its heartbeat lacks "apiKey", and only a restart puts the worker on the daemon of this version
claude_login_old_rule() { # $1 what claude_login_json printed
  echo "$1" | grep '"loggedIn": *true' | grep -v '"apiKey":' >/dev/null
}
cmd_claude() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    login)
      cat <<'EOT'
Sign in to Claude on the grid.

Claude Code itself does the sign-in, in your own grid account, and keeps its credential in
~/.beethoven/claude (permissions 700). Beethoven never sees, copies or stores it. The same sign-in serves
your Claude worker and phone access.

Claude will print a link: Ctrl+click it (or copy it into your browser), sign in with the Claude
account you made with your Wayne State e-mail, press Authorize, then paste the code the page shows
back here. Use one Claude account only: the one that is yours.
EOT
      claude_in_alloc auth login; local rc=$?
      [ $rc = 4 ] && die "Claude on the grid is signed in, but not with a Claude subscription, and Beethoven runs only on your own Claude subscription: run beethoven claude login again and sign in with your Claude subscription. Nothing runs on this sign-in."
      [ $rc = 0 ] || die "Claude Code's sign-in did not complete (exit $rc); run beethoven claude login again"
      if consent_given; then
        echo; echo "Done. Your workers pick the sign-in up by themselves; phone access is already enabled."
      else
        cat <<'EOT'

One more question, asked once by Claude Code itself: it now starts a Remote Control session on this
compute node and asks "Enable Remote Control? (y/n)". Answer y, wait for "Connected", then press
Ctrl+C. After that your workers host phone access by themselves; you will not be asked again.
EOT
        claude_in_alloc remote-control || true
        if consent_given; then echo; echo "Done. Phone access is enabled for your workers (Beethoven: Phone access)."; else echo; echo "Not recorded yet: run  beethoven claude remote-consent  when you want phone access."; fi
      fi;;
    remote-consent)
      cat <<'EOT'
Phone access: Claude Code asks once whether to enable Remote Control. Answer it yourself here.

When it asks "Enable Remote Control? (y/n)" type y. When you see the session link, press Ctrl+C to
leave; from then on your worker hosts Remote Control whenever phone access is on. While connected,
the session transcript (your messages, Claude's answers, tool activity) is stored on Anthropic's
servers: keep confidential data out of phone sessions.
EOT
      if consent_given; then echo "Already answered: your workers host Remote Control whenever phone access is on."; else claude_in_alloc remote-control || true; fi
      if consent_given; then echo; echo "recorded by Claude Code: your workers may now host Remote Control (Beethoven: Phone access)"
      else echo; printf 'Did you answer y to "Enable Remote Control?" [y/N] '; local a; read -r a
        if [[ "$a" =~ ^[Yy] ]]; then local m t; t=$(date -u +%FT%TZ); for m in "${CONSENT_MARKERS[@]}"; do printf '%s\n' "$t" > "$m"; done; echo "recorded: your workers may now host Remote Control (Beethoven: Phone access)"; else echo "not recorded; run this again when you want phone access"; fi
      fi;;
    status)
      local present=false consent=false; [ -s "$CLAUDE_HOME/.credentials.json" ] && present=true; consent_given && consent=true
      if [ "${1:-}" = "--json" ]; then printf '{"dir_present":%s,"consent":%s,"login":%s}\n' "$present" "$consent" "$(claude_login_json)"
      else echo "sign-in file present: $present; Remote Control consent: $consent; a running worker says: $(claude_login_json)"; fi;;
    forget) # the command of grid scripts 8 and older deleted the sign-in folder; that is never done again
      die "Beethoven never deletes or signs out a Claude sign-in. To sign out, run claude auth logout yourself on a compute node.";;
    *) die "claude: login|status [--json]|remote-consent";;
  esac
}

cmd_relay() {
  # One long-lived ssh session instead of one per message. Protocol, one line each way:
  #   -> SEND <worker> <json>        queue a request        <- QUEUED <id> <epoch_ms>
  #   -> RESULT <worker> <id>        ask for a result       <- RESULT <id> <json> | PENDING <id>
  #   -> PING                                               <- PONG <epoch_ms>
  #   -> QUIT
  # Results and events of everything queued through this session are pushed as they appear:
  #   <- EVENT <id> <json line>   <- RESULT <id> <json>
  # The loop wakes every 250 ms (read -t) to look at pending files; a sleep-and-stat loop is
  # the kind of load the login node is for.
  local -A pw poff   # id -> worker, id -> events offset
  local line cmd rest worker json id
  echo "READY $(date +%s%3N) $VERSION"
  while :; do
    if IFS= read -r -t 0.25 line; then
      cmd=${line%% *}; rest=${line#* }
      case "$cmd" in
        SEND)
          worker=${rest%% *}; json=${rest#* }
          id=$(printf '%s' "$json" | grep -o '"id": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
          if ! valid_id "$id" || ! valid_worker "$worker" || [ ! -d "$BEETHOVEN_HOME/workers/$worker" ]; then echo "ERROR bad request or unknown worker '$worker'"; continue; fi
          mkdir -p "$BEETHOVEN_HOME/workers/$worker/inbox" "$BEETHOVEN_HOME/workers/$worker/outbox"
          printf '%s' "$json" > "$BEETHOVEN_HOME/workers/$worker/inbox/$id.json.part" && mv "$BEETHOVEN_HOME/workers/$worker/inbox/$id.json.part" "$BEETHOVEN_HOME/workers/$worker/inbox/$id.json"
          pw[$id]=$worker; poff[$id]=0
          echo "QUEUED $id $(date +%s%3N)";;
        RESULT)
          worker=${rest%% *}; id=${rest#* }
          if ! valid_worker "$worker" || ! valid_id "$id"; then echo "ERROR bad worker or request id"; continue; fi
          if [ -s "$BEETHOVEN_HOME/workers/$worker/outbox/$id.json" ]; then printf 'RESULT %s ' "$id"; tr -d '\n' < "$BEETHOVEN_HOME/workers/$worker/outbox/$id.json"; echo; else echo "PENDING $id"; fi;;
        PING) echo "PONG $(date +%s%3N)";;
        QUIT) exit 0;;
        *) echo "ERROR unknown command";;
      esac
    else
      [ $? -gt 128 ] || exit 0   # stdin closed: the laptop went away
      for id in "${!pw[@]}"; do
        worker=${pw[$id]}
        local ev="$BEETHOVEN_HOME/workers/$worker/outbox/$id.events.jsonl" out="$BEETHOVEN_HOME/workers/$worker/outbox/$id.json"
        if [ -f "$ev" ]; then
          local size; size=$(stat -c %s "$ev" 2>/dev/null || echo 0)
          if [ "$size" -gt "${poff[$id]}" ]; then tail -c +$(( poff[$id] + 1 )) "$ev" | head -c $(( size - poff[$id] )) | sed "s/^/EVENT $id /"; poff[$id]=$size; fi
        fi
        if [ -s "$out" ]; then printf 'RESULT %s ' "$id"; tr -d '\n' < "$out"; echo; unset "pw[$id]" "poff[$id]"; fi
      done
    fi
  done
}

# ---- lab access: one folder, read-only, requests carried by Slurm ---------------------------
# Philosophy: the lab admin curates the lab folder SHARED=/rs/rs_grp_oschome/shared (datasets,
# containers, software). Students only ever READ it; they do all their science in their own grid
# accounts. So nothing under the volume is writable by students, not even a request drop-box.
#
# A request is a held, zero-work Slurm job named ashley_access whose comment ("ashley-access v1
# note=...") carries the note. That job name and tag are a format between the student's command and
# the admin's, and keep their spelling from before the rename: an admin whose tool is older than grid
# scripts 7 looks for exactly them. The admin's side accepts beethoven_access and "beethoven-access v1
# note=" as well, for the day every such tool is retired and the student side can switch.
# Slurm authenticates the submitter, so a request cannot be forged or squatted, and it uses no
# storage. The admin's ingest reads them (squeue shows every user's jobs on this grid), writes a
# status file only the admin can write and only that student can read, and gives the applicant a
# traverse-only ACL on the path to it. Approval = POSIX ACLs (CephFS honours them; the admin owns
# the volume): read-only on SHARED and everything under it except access/. The volume root is not
# open to other users at all: its other::--- and its named entries are the gate, and the entries are
# also the approved list hpcworker's tools/grid_access.sh keeps (user:<id>:rwx). Below the gate the
# lab's shared folder (shared/beethoven: hpcworker's shared copy, the lab's image) stays readable by
# other, because the browser and desktop editions' students reach it through the gate alone; access
# init and library publish never close it (grid scripts 9).
#   /rs/rs_grp_oschome      2770 + per-user --x ACLs    (default ACL o::--- for new entries)
#   shared/                 2755 + per-user r-x/--x     (group and other read, only the admin writes)
#   shared/beethoven        2755, other's r-X kept      (hpcworker's copy, containers, library.json)
#   shared/<anything else>  2750 + per-user r-X         (datasets, software)
#   shared/access           2710 + per-user --x
#   shared/access/status    2710 + per-user --x; status/<id>.json 600 + ACL u:<id>:r--
#   shared/access/requests  2700  the admin's decision log
VOL="$(dirname "$SHARED")"
STATUS_DIR="$ACCESS_ROOT/status"
LOG_DIR="$ACCESS_ROOT/requests"
access_admin() { stat -c %U "$SHARED" 2>/dev/null || echo "${BEETHOVEN_ADMIN:-${ASHLEY_ADMIN:-}}"; }
is_admin() { [ "$(access_admin)" = "$USER" ]; }
lab_mode() { [ "${BEETHOVEN_LAB:-${ASHLEY_LAB:-1}}" = 1 ]; }    # Beethoven is the lab's tool: the container comes with lab access
status_file() { echo "$STATUS_DIR/$1.json"; }
status_field() { # ID FIELD
  [ -r "$(status_file "$1")" ] || { echo ""; return; }
  grep -o "\"$2\": *\"[^\"]*\"" "$(status_file "$1")" | head -1 | sed 's/.*"\([^"]*\)"$/\1/'
}
REQUEST_JOB=ashley_access; REQUEST_JOBS=ashley_access,beethoven_access   # filed under the first, both are read
own_request_job() { squeue -h -u "$USER" -n "$REQUEST_JOBS" -t PD -o %i 2>/dev/null | head -1; }
sanitize_note() { printf '%s' "$1" | tr -cd 'A-Za-z0-9 ,.:;()/_@+-' | cut -c1-200; }
decision_log() { printf '%s %s %s %s\n' "$(date -u +%FT%TZ)" "$1" "$2" "$3" >> "$LOG_DIR/decisions.log" 2>/dev/null; }
write_status() { # ID STATE NOTE MESSAGE REQUESTED JOB
  local f; f=$(status_file "$1")
  ( umask 077
    printf '{"user":%s,"name":%s,"state":%s,"note":%s,"message":%s,"requested":%s,"job":%s,"decided":%s,"by":%s}\n' \
      "$(json_str "$1")" "$(json_str "$(getent passwd "$1" | cut -d: -f5)")" "$(json_str "$2")" "$(json_str "$3")" "$(json_str "$4")" "$(json_str "$5")" "$(json_str "$6")" "$(json_str "$(date -u +%FT%TZ)")" "$(json_str "$USER")" > "$f.part" && mv "$f.part" "$f" )
  setfacl -m "u:$1:r--" "$f" 2>/dev/null || chmod 644 "$f"
}
# On the volume root an entry is added only where the user has none, and only the --x one this file adds
# is ever taken away: an rwx entry is hpcworker's list, lowered or removed it would stop that student
# making their own folder there
vol_entry() { getfacl -cp "$VOL" 2>/dev/null | grep "^user:$1:" | head -1 | cut -d: -f3 | cut -c1-3; }
vol_traverse() { # ID add|remove
  local e; e=$(vol_entry "$1")
  if [ "$2" = add ]; then [ -n "$e" ] || setfacl -m "u:$1:--x" "$VOL"
  else [ "$e" != --x ] || setfacl -x "u:$1" "$VOL"; fi
}
path_traverse() { # ID add|remove: pass-through to the applicant's own status file
  local d
  vol_traverse "$1" "$2" 2>/dev/null
  for d in "$SHARED" "$ACCESS_ROOT" "$STATUS_DIR"; do
    if [ "$2" = add ]; then setfacl -m "u:$1:--x" "$d" 2>/dev/null; else setfacl -x "u:$1" "$d" 2>/dev/null; fi
  done
}
acl_grant() { # ID: read-only on everything in the lab folder except access/; returns the failure count
  local fails=0 c
  vol_traverse "$1" add || fails=$((fails + 1))
  setfacl -m "u:$1:r-x" "$SHARED" && setfacl -d -m "u:$1:r-X" "$SHARED" || fails=$((fails + 1))
  for c in "$SHARED"/*; do
    [ "$c" = "$ACCESS_ROOT" ] && continue
    [ -L "$c" ] && continue                        # never follow a link out of the lab folder
    [ -e "$c" ] || continue
    setfacl -R -P -m "u:$1:r-X" "$c" 2>/dev/null || fails=$((fails + 1))
    find "$c" -type d -exec setfacl -d -m "u:$1:r-X" {} + 2>/dev/null
  done
  return $fails
}
acl_revoke() { # ID: removes read access to the lab folder (keeps the pass-through to the status file)
  local c
  for c in "$SHARED"/*; do
    [ "$c" = "$ACCESS_ROOT" ] && continue
    [ -L "$c" ] && continue
    setfacl -R -P -x "u:$1" "$c" 2>/dev/null; find "$c" -type d -exec setfacl -d -x "u:$1" {} + 2>/dev/null
  done
  setfacl -d -x "u:$1" "$SHARED" 2>/dev/null; setfacl -m "u:$1:--x" "$SHARED" 2>/dev/null
  return 0
}
approved_users() { local f; for f in "$STATUS_DIR"/*.json; do [ -s "$f" ] || continue; grep -q '"state": *"approved"' "$f" && basename "$f" .json; done; }
# curl with a secret header, without the secret ever appearing in the process list
curl_auth() { # TOKEN URL [extra header lines...]
  local tok="$1" url="$2"; shift 2
  { printf 'header = "Authorization: Bearer %s"\n' "$tok"; for h in "$@"; do printf 'header = "%s"\n' "$h"; done; } | curl -s -m 15 -K - "$url"
}
curl_auth_code() { # TOKEN URL [extra header lines...] -> HTTP status code
  local tok="$1" url="$2"; shift 2
  { printf 'header = "Authorization: Bearer %s"\n' "$tok"; for h in "$@"; do printf 'header = "%s"\n' "$h"; done; } | curl -s -m 15 -o /dev/null -w '%{http_code}' -K - "$url"
}
student_state() { # none | filed | pending | approved | approved_unreadable | denied | removed
  if lib_granted; then echo approved; return; fi
  local s; s=$(status_field "$USER" state)
  case "$s" in
    approved) echo approved_unreadable;;
    pending|denied|removed) echo "$s";;
    *) [ -n "$(own_request_job)" ] && echo filed || echo none;;
  esac
}
tidy_request_job() { # once decided, the held request job has done its job
  local s; s=$(student_state)
  case "$s" in approved|approved_unreadable|denied|removed) local j; j=$(own_request_job); [ -n "$j" ] && scancel "$j" 2>/dev/null;; esac
}
admin_ingest() { # read pending request jobs; open a status file for each new applicant
  local line id u note req
  while IFS='|' read -r id u note req; do
    [ -n "$u" ] || continue
    getent passwd "$u" >/dev/null || continue
    [ -s "$(status_file "$u")" ] && continue       # already known (pending or decided)
    note="${note#ashley-access v1 note=}"; note=$(sanitize_note "${note#beethoven-access v1 note=}")
    path_traverse "$u" add
    write_status "$u" pending "$note" "" "$req" "$id"
    decision_log "$u" filed "job $id"
  done < <(squeue -h -n "$REQUEST_JOBS" -t PD -o '%i|%u|%k|%V' 2>/dev/null)
}
cmd_access() {
  local sub="${1:-status}"; shift || true
  case "$sub" in
    init)  # admin: the permission layout, printed as it is applied; safe to rerun
      is_admin || die "only the owner of $SHARED can run access init"
      local e others=""
      chmod o-rwx "$VOL" && echo "chmod o-rwx $VOL (no longer open to other grid users)"
      setfacl -d -m u::rwx,g::rwx,o::--- "$VOL" 2>/dev/null && echo "default ACL on $VOL: new entries start closed to others"
      for e in "$VOL"/*; do
        [ "$e" = "$SHARED" ] && continue
        if [ "$(stat -c %U "$e")" = "$USER" ]; then chmod o-rwx "$e"; elif [ -n "$(find "$e" -maxdepth 0 -perm /o=rwx 2>/dev/null)" ]; then others="$others $e"; fi
      done
      [ -n "$others" ] && echo "note: these entries belong to other members and are open to others; their owners can close them with chmod o-rwx:$others"
      # other below the gate is only who the volume root lets in; the lab's shared folder must stay readable to
      # them (hpcworker's copy, the image), so shared/ is entered and listed by other and that folder keeps
      # other's read and enter, while everything else here stays closed to other as before
      chmod 2755 "$SHARED" && setfacl -d -m u::rwx,g::r-x,o::--- "$SHARED" && echo "chmod 2755 $SHARED (group and other read, only you write; new entries closed to others)"
      for e in "$SHARED"/*; do
        [ "$e" = "$ACCESS_ROOT" ] && continue; [ -L "$e" ] && continue
        if [ "$e" = "$LIBRARY_ROOT" ] || [ "$e" = "$SHARED/beethoven" ]; then chmod -R g-w,o-w "$e" 2>/dev/null
        else chmod -R g-w,o-rwx "$e" 2>/dev/null; fi
        find "$e" -type d -exec chmod g+s {} + 2>/dev/null
      done
      echo "lab folder contents: group read-only; $LIBRARY_ROOT readable by the accounts the volume root lets in, the rest closed to others"
      mkdir -p "$STATUS_DIR" "$LOG_DIR"
      rm -rf "$ACCESS_ROOT/inbox" && echo "removed the old world-writable drop-box"
      chmod 2710 "$ACCESS_ROOT" "$STATUS_DIR"; chmod 2700 "$LOG_DIR"
      local f; for f in "$STATUS_DIR"/*.json; do [ -s "$f" ] || continue; chmod 600 "$f"; setfacl -m "u:$(basename "$f" .json):r--" "$f" 2>/dev/null; path_traverse "$(basename "$f" .json)" add; done
      mkdir -p "$BEETHOVEN_HOME/bin"; printf '#!/bin/bash\ntrue\n' > "$BIN/access_request.sbatch"; chmod 755 "$BIN/access_request.sbatch"
      cmd_access admin resync >/dev/null && echo "re-applied access for approved users"
      echo "access ready: requests arrive as held Slurm jobs named $REQUEST_JOB (or beethoven_access)";;
    whoami)
      local adm st; adm=$(access_admin); st=$(is_admin && echo admin || student_state)
      is_admin || tidy_request_job
      if [ "${1:-}" = "--json" ]; then printf '{"user":%s,"admin":%s,"lab_admin":%s,"granted":%s,"state":%s}\n' "$(json_str "$USER")" "$(is_admin && echo true || echo false)" "$(json_str "$adm")" "$(lib_granted && echo true || echo false)" "$(json_str "$st")"
      else echo "user $USER; lab admin $adm; state $st"; fi;;
    status)
      local st; st=$(student_state); tidy_request_job
      if [ "${1:-}" = "--json" ]; then
        printf '{"granted":%s,"state":%s,"message":%s,"decided":%s}\n' "$(lib_granted && echo true || echo false)" "$(json_str "$st")" "$(json_str "$(status_field "$USER" message)")" "$(json_str "$(status_field "$USER" decided)")"
      else echo "lab access: $st$([ -n "$(status_field "$USER" message)" ] && echo " ($(status_field "$USER" message))")"; fi;;
    requirements)
      # A request is the LAST step: everything the lab works with must already work. The shared
      # container is not a requirement: it is what access gives.
      local missing=() as_json=0; [ "${1:-}" = "--json" ] && as_json=1
      local vt; vt=$(cmd_verify_tokens 2>/dev/null || true)
      echo "$vt" | grep "^HF_TOKEN ok" >/dev/null || missing+=("Hugging Face token missing or rejected")
      echo "$vt" | grep "^GITHUB_TOKEN ok" >/dev/null || missing+=("GitHub token missing or rejected")
      has_bashrc_block || missing+=("bashrc block missing (run the grid step again)")
      if [ $as_json -eq 1 ]; then
        printf '{"ok":%s,"missing":[' "$([ ${#missing[@]} -eq 0 ] && echo true || echo false)"; local first=1; for m in "${missing[@]}"; do [ $first -eq 1 ] || printf ','; first=0; json_str "$m"; done; echo ']}'
      else
        if [ ${#missing[@]} -eq 0 ]; then echo "eligible"; else echo "not eligible yet:"; printf '  - %s\n' "${missing[@]}"; fi
      fi
      [ ${#missing[@]} -eq 0 ];;
    request)
      local note=""; while [ $# -gt 0 ]; do case "$1" in --note) note="$2"; shift 2;; *) shift;; esac; done
      is_admin && { echo "you are the lab admin"; return 0; }
      local st; st=$(student_state)
      case "$st" in
        approved) echo "you already have lab access"; return 0;;
        filed|pending) echo "your request is already with your lead ($st)"; return 0;;
        denied|removed|approved_unreadable) die "your request was already decided ($st); ask your lead to reset it if you need to ask again";;
      esac
      cmd_access requirements >/dev/null || { cmd_access requirements; die "finish the setup first; requests are for working environments"; }
      [ -x "$BIN/access_request.sbatch" ] || { printf '#!/bin/bash\ntrue\n' > "$BIN/access_request.sbatch"; chmod 755 "$BIN/access_request.sbatch"; }
      note=$(sanitize_note "$note")
      local out; out=$(cd "$BEETHOVEN_HOME/log" 2>/dev/null || cd "$HOME"; sbatch --parsable --hold -J "$REQUEST_JOB" -p reqp -q requeue -t 1 -n 1 --mem=16M -o /dev/null --comment "ashley-access v1 note=$note" "$BIN/access_request.sbatch" 2>&1) || die "could not file the request: $out"
      echo "request filed (held Slurm job ${out%%;*}; it never runs); your lead approves it in Beethoven";;
    admin)
      is_admin || die "only the lab admin ($(access_admin)) can manage requests"
      local act="${1:-list}"; shift || true
      admin_ingest
      case "$act" in
        list)
          if [ "${1:-}" = "--json" ]; then
            printf '{"admin":%s,"requests":[' "$(json_str "$USER")"; local first=1 f
            for f in "$STATUS_DIR"/*.json; do [ -s "$f" ] || continue; [ $first -eq 1 ] || printf ','; first=0; tr -d '\n' < "$f"; done; echo ']}'
          else local f; for f in "$STATUS_DIR"/*.json; do [ -s "$f" ] && cat "$f"; done; fi;;
        approve|grant)
          local id="${1:?approve ID}"; getent passwd "$id" >/dev/null || die "no grid user $id"
          path_traverse "$id" add
          local fails=0; acl_grant "$id" || fails=$?
          write_status "$id" approved "$(status_field "$id" note)" "" "$(status_field "$id" requested)" "$(status_field "$id" job)"
          decision_log "$id" approved "failures=$fails"
          if [ "$fails" -gt 0 ]; then echo "$id approved, but $fails part(s) of the lab folder could not be opened (not owned by you?)"; else echo "$id approved: reads the lab folder $SHARED"; fi
          # the volume root's full entries are the grid's approved list, which hpcworker's tools/grid_access.sh keeps
          # equal to its roster and which removes every other named entry, the enter-only one this approval
          # needs included; until one list holds both, say so where the decision is made
          [ "$(vol_entry "$id")" = rwx ] || echo "note: $id is not on the grid's approved list (hpcworker's roster); its next sync removes the entry that lets $id into $VOL, and with it the lab folder: add $id to that list too";;
        deny|remove)
          local id="${1:?$act ID}" msg=""; shift; while [ $# -gt 0 ]; do case "$1" in --message) msg="$2"; shift 2;; *) shift;; esac; done
          msg=$(sanitize_note "$msg")
          acl_revoke "$id"; path_traverse "$id" add
          write_status "$id" "$([ "$act" = deny ] && echo denied || echo removed)" "$(status_field "$id" note)" "$msg" "$(status_field "$id" requested)" "$(status_field "$id" job)"
          decision_log "$id" "$act" "$msg"; echo "$id ${act}${msg:+: $msg}";;
        reset)
          local id="${1:?reset ID}"; acl_revoke "$id"; path_traverse "$id" remove; rm -f "$(status_file "$id")"; decision_log "$id" reset ""; echo "$id reset: may request again";;
        resync)
          local u n=0; for u in $(approved_users); do acl_grant "$u" >/dev/null 2>&1; n=$((n + 1)); done; echo "re-applied lab access for $n approved user(s)";;
        *) die "access admin: list|approve ID|deny ID [--message ..]|remove ID [--message ..]|reset ID|resync";;
      esac;;
    *) die "access: init|whoami|status|requirements|request [--note ..]|admin ...";;
  esac
}

cmd_phone() { # phone access through Claude Code Remote Control, hosted by a worker (see phone.js)
  local sub="${1:-status}"; shift || true
  local worker="default" as_json=0
  while [ $# -gt 0 ]; do case "$1" in --worker) worker="$2"; shift 2;; --json) as_json=1; shift;; *) shift;; esac; done
  valid_worker "$worker" || die "bad worker name"
  local w="$BEETHOVEN_HOME/workers/$worker" rc="$BEETHOVEN_HOME/workers/$worker/rc"
  [ -d "$w" ] || die "no worker '$worker' (start one first)"
  case "$sub" in
    on) # one worker hosts phone access (they share one login); turning it on here turns it off elsewhere
      local ow moved=""; for ow in "$BEETHOVEN_HOME"/workers/*/rc/enable; do [ -e "$ow" ] || continue; ow=$(basename "$(dirname "$(dirname "$ow")")")
        [ "$ow" = "$worker" ] || { rm -f "$BEETHOVEN_HOME/workers/$ow/rc/enable"; moved="$moved $ow"; }; done
      [ -s "$CLAUDE_HOME/.credentials.json" ] || echo "note: Claude is not signed in on the grid yet (beethoven claude login); phone access waits for it"
      consent_given || echo "note: Remote Control has not been enabled yet (beethoven claude remote-consent); phone access waits for it"
      mkdir -p "$rc" && chmod 700 "$rc" && touch "$rc/enable" && echo "phone access starting on worker $worker ($(cat "$w/node" 2>/dev/null || echo 'node not assigned yet'))${moved:+; moved from$moved}";;
    off) rm -f "$rc/enable"; echo "phone access off on worker $worker";;
    status)
      local alive=false; [ "$(job_state "$(cat "$w/job.id" 2>/dev/null)")" = RUNNING ] && alive=true
      if [ $as_json -eq 1 ]; then
        local host="null"; [ -s "$BEETHOVEN_HOME/remote/host.lock/holder.json" ] && host=$(tr -d '\n' < "$BEETHOVEN_HOME/remote/host.lock/holder.json")
        printf '{"worker":%s,"job_running":%s,"enabled":%s,"host":%s,"status":' "$(json_str "$worker")" "$alive" "$([ -e "$rc/enable" ] && echo true || echo false)" "$host"
        if [ -s "$rc/status.json" ]; then tr -d '\n' < "$rc/status.json"; else printf '{"phase":"off"}'; fi; echo '}'
      else echo "worker $worker running=$alive enabled=$([ -e "$rc/enable" ] && echo yes || echo no)"; cat "$rc/status.json" 2>/dev/null; fi;;
    *) die "phone: on|off|status [--worker NAME]";;
  esac
}

# ---- diagnostics: every grid-side assumption as a checkable node ------------------------------
# `beethoven diag --json [--repair] [--node]` prints {"nodes":[{id, ok, warn, skip, detail, repaired}]}.
# The laptop maps these into its dependency graph. Checks are cheap; nothing heavy runs on the
# login node. --node also checks the compute node inside a running worker's allocation.
diag_emit() { # ID OK(true|false) WARN SKIP DETAIL [REPAIRED]
  [ "$DIAG_FIRST" = 1 ] || printf ','; DIAG_FIRST=0
  printf '{"id":%s,"ok":%s,"warn":%s,"skip":%s,"detail":%s,"repaired":%s}' "$(json_str "$1")" "$2" "$3" "$4" "$(json_str "$5")" "$(json_str "${6:-}")"
}
sysroot_paths() { grep -o '"/wsu/apps/vscode/[^"]*"' "$BIN/bashrc.block" 2>/dev/null | tr -d '"' | tr ':' '\n'; }
discover_sysroot() { # newest C&IT VS Code sysroot and patchelf, if Wayne State moved them
  local ld pe; ld=$(ls -1d /wsu/apps/vscode/sysroot*/x86_64-linux-gnu/x86_64-linux-gnu/sysroot/lib/ld-linux-x86-64.so.2 /wsu/apps/vscode/*/sysroot/lib/ld-linux-x86-64.so.2 2>/dev/null | sort -V | tail -1)
  pe=$(ls -1d /wsu/apps/vscode/patchelf/*/bin/patchelf 2>/dev/null | sort -V | tail -1)
  [ -n "$ld" ] && [ -n "$pe" ] || return 1
  local lib; lib=$(dirname "$ld")
  printf '%s\n' "# >>> beethoven (managed; \"beethoven install\" rewrites this block) >>>" \
    "# VS Code Remote-SSH on this grid needs the sysroot C&IT provides (rediscovered by beethoven diag --repair)." \
    "export VSCODE_SERVER_CUSTOM_GLIBC_LINKER=\"$ld\"" \
    "export VSCODE_SERVER_CUSTOM_GLIBC_PATH=\"$lib:${lib}64\"" \
    "export VSCODE_SERVER_PATCHELF_PATH=\"$pe\"" \
    "# The Beethoven grid command (beethoven status, beethoven worker start, beethoven ask ...)." \
    "export PATH=\"\$HOME/.beethoven/bin:\$PATH\"" "# <<< beethoven <<<" > "$BIN/bashrc.block"
}
discover_runtime() { bash -lc 'module load apptainer >/dev/null 2>&1 && command -v apptainer' 2>/dev/null | tail -1; }
cmd_diag() {
  local repair=0 node=0
  while [ $# -gt 0 ]; do case "$1" in --repair) repair=1;; --node) node=1;; --json) ;; esac; shift; done
  load_cfg
  DIAG_FIRST=1; printf '{"version":%s,"host":%s,"user":%s,"nodes":[' "$(json_str "$VERSION")" "$(json_str "$(hostname)")" "$(json_str "$USER")"
  # scripts
  local miss=""; for f in beethoven beethovend.js phone.js license.js license_keys.json worker.sbatch.tpl bootstrap.sbatch bashrc.block VERSION; do [ -s "$BIN/$f" ] || miss="$miss $f"; done
  if grep -q $'\r' "$BIN/beethoven" "$BIN/beethovend.js" 2>/dev/null; then miss="$miss (CR line endings)"; fi
  # the old names lead to the new files (older builds and job files call them); repair makes the links
  if { [ ! -L "$BIN/ashley" ] || [ ! -L "$BIN/ashleyd.js" ]; } && [ $repair = 1 ] && [ -s "$BIN/beethoven" ]; then old_names 2>/dev/null; fi
  { [ -L "$BIN/ashley" ] && [ -L "$BIN/ashleyd.js" ]; } || miss="$miss (links ashley, ashleyd.js)"
  if [ -z "$miss" ]; then diag_emit grid.scripts true false false "Beethoven v$VERSION in $BIN"; else diag_emit grid.scripts false false false "missing or damaged:$miss"; fi
  # bashrc block and the VS Code sysroot it points at
  if has_bashrc_block; then diag_emit grid.bashrc-block true false false "present in ~/.bashrc"
  elif [ $repair = 1 ] && cmd_install >/dev/null 2>&1 && has_bashrc_block; then diag_emit grid.bashrc-block true false false "rewritten" "ran beethoven install"
  else diag_emit grid.bashrc-block false false false "the Beethoven block is missing from ~/.bashrc"; fi
  local p gone=""; for p in $(sysroot_paths); do [ -e "$p" ] || gone="$gone $p"; done
  if [ -z "$gone" ]; then diag_emit grid.vscode-sysroot true false false "C&IT VS Code sysroot and patchelf present"
  elif [ $repair = 1 ] && discover_sysroot && cmd_install >/dev/null 2>&1; then diag_emit grid.vscode-sysroot true false false "moved paths rediscovered" "rewrote the bashrc block with the new sysroot"
  else diag_emit grid.vscode-sysroot false false false "sysroot paths gone (Wayne State moved them?):$gone"; fi
  # Slurm
  if command -v sbatch >/dev/null && squeue -h -u "$USER" >/dev/null 2>&1; then diag_emit grid.slurm true false false "sbatch/squeue answer"; else diag_emit grid.slurm false false false "sbatch or squeue not usable"; fi
  if scontrol show config 2>/dev/null | grep -E 'PrivateData *= *none' >/dev/null; then diag_emit grid.slurm-visibility true false false "PrivateData=none: lab-access requests are visible to the admin"
  else diag_emit grid.slurm-visibility true true false "Slurm hides other users' jobs now: the admin cannot see access requests; ask C&IT or fall back to grants"; fi
  local q; q=$(sacctmgr -n -P show assoc where user="$USER" format=qos 2>/dev/null | tr ',' '\n' | sort -u | tr '\n' ' ')
  if echo " $q " | grep -E ' (requeue|secondary) ' >/dev/null; then diag_emit grid.qos true false false "QoS available: $q"; else diag_emit grid.qos false false false "neither requeue nor secondary QoS is on this account (have: ${q:-none})"; fi
  # tools and network from the login node
  local code; code=$(printf 'url = "https://api.anthropic.com/"\n' | curl -s -m 12 -o /dev/null -w '%{http_code}' -K - 2>/dev/null)
  if [ -n "$code" ] && [ "$code" != 000 ]; then diag_emit grid.internet true false false "api.anthropic.com answers (HTTP $code); curl reads secrets from stdin"; else diag_emit grid.internet false false false "no HTTPS from the login node, or curl -K - unsupported"; fi
  # /tmp on the login node is not for user files (C&IT, 2026-09-28); container builds left rootfs-* there once.
  # Reported, never removed: repair runs over ssh with no one at a terminal, and a big file there may be the
  # student's own (grid scripts 9)
  local leftovers; leftovers=$(find /tmp -maxdepth 1 -user "$USER" \( -name 'rootfs-*' -o -name 'build-temp-*' -o -name 'apptainer*' -o -name 'singularity*' -o -name 'sbuild-*' -o -size +50M \) 2>/dev/null | head -8 | tr '\n' ' ')
  if [ -z "$leftovers" ]; then diag_emit grid.login-tmp true false false "nothing of yours left under /tmp on $(hostname -s)"
  else diag_emit grid.login-tmp false false false "files of yours under /tmp on the login node: $leftovers (C&IT asks that /tmp here stays free: delete the ones you no longer need, in a terminal on the grid; Beethoven deletes nothing there)"; fi
  if command -v setfacl >/dev/null && command -v getfacl >/dev/null; then diag_emit grid.acl-tools true false false "setfacl/getfacl present"; else diag_emit grid.acl-tools false false false "setfacl/getfacl missing"; fi
  read -r used soft < <(home_quota)
  if [ -n "${soft:-}" ] && [ "${soft%.*}" -gt 0 ] 2>/dev/null; then
    local pct=$(( ${used%.*} * 100 / ${soft%.*} ))
    if [ $pct -ge 98 ]; then diag_emit grid.home-quota false false false "home at $pct % of its soft quota: jobs will fail to write"
    elif [ $pct -ge 90 ]; then diag_emit grid.home-quota true true false "home at $pct % of its soft quota"
    else diag_emit grid.home-quota true false false "home at $pct %"; fi
  else diag_emit grid.home-quota true true false "quota not readable"; fi
  # tokens (verified from here, never on argv)
  local vt; vt=$(cmd_verify_tokens 2>/dev/null)
  for pair in GITHUB_TOKEN:grid.token-github HF_TOKEN:grid.token-hf; do
    local k=${pair%%:*} id=${pair#*:} line; line=$(echo "$vt" | grep "^$k" | head -1)
    case "$line" in "$k ok"*) diag_emit "$id" true false false "$line";; "$k present"*) diag_emit "$id" true true false "$line";; *) diag_emit "$id" false false false "${line:-$k missing}";; esac
  done
  # the Claude sign-in: Claude Code's own answer from a running worker; the file's presence otherwise
  local lj; lj=$(claude_login_json)
  if claude_login_other "$lj"; then diag_emit grid.claude-login false false false "Claude Code on the grid is signed in, but not with a Claude subscription, and Beethoven runs only on your own subscription: sign in again with it (Beethoven: Sign in to Claude on the grid)"
  elif claude_login_old_rule "$lj"; then diag_emit grid.claude-login true true false "Claude Code on the grid is signed in$(echo "$lj" | grep -o '"email": *"[^"]*"' | cut -d'"' -f4 | sed 's/^/ as /'), but the worker that says so was started before grid scripts 9 and does not yet look for an API key behind the sign-in: restart it (Beethoven: Stop a worker, then Start)"
  elif echo "$lj" | grep '"loggedIn": *true' >/dev/null; then diag_emit grid.claude-login true false false "Claude Code on the grid is signed in$(echo "$lj" | grep -o '"email": *"[^"]*"' | cut -d'"' -f4 | sed 's/^/ as /')"
  elif [ "$lj" != null ] && echo "$lj" | grep '"loggedIn": *false' >/dev/null; then diag_emit grid.claude-login false false false "Claude Code on the grid is not signed in: run Beethoven: Sign in to Claude on the grid"
  elif [ -s "$CLAUDE_HOME/.credentials.json" ]; then diag_emit grid.claude-login true true false "a sign-in is stored; a running worker will confirm it"
  else diag_emit grid.claude-login false false false "not signed in on the grid yet: run Beethoven: Sign in to Claude on the grid"; fi
  # accounts: no stored Claude tokens (the tool stopped storing them before the rename). Only reported: accounts/
  # is also where the engine keeps the student's other sign-ins, and nothing of ours deletes there (grid scripts 9)
  local legacy="" fixed="" ad
  for ad in "$BEETHOVEN_HOME"/accounts/*/; do [ -d "$ad" ] || continue
    { [ -s "$ad/token" ] || [ -s "$ad/.credentials.json" ]; } && legacy="$legacy $(basename "$ad")"
  done
  # the API key an earlier version stored for its paid overflow: never read since grid scripts 8, and never
  # deleted here (repair runs over ssh with no one at a terminal); only its presence is checked
  local retired="" live=""; [ -e "$BEETHOVEN_HOME/accounts/apikey/apikey" ] && retired=1
  [ -n "$retired" ] && [ ! -e "$BEETHOVEN_HOME/accounts/apikey/disabled" ] && live=1
  if [ -n "$live" ] && [ $repair = 1 ]; then retire_apikey; fixed="marked the stored API key disabled, so a worker of an earlier version cannot use it (nothing deleted)"; live=""; fi
  if [ -n "$live" ]; then diag_emit grid.accounts false false false "an Anthropic API key an earlier version stored is in ~/.beethoven/accounts/apikey and is not marked disabled, so a worker started by that version could still spend on it (repair marks it disabled and deletes nothing; beethoven accounts remove --yes deletes it)"
  elif [ -n "$retired" ]; then diag_emit grid.accounts true true false "an Anthropic API key an earlier version stored is still in ~/.beethoven/accounts/apikey; Beethoven never uses or sends it (it is marked disabled). To delete it: beethoven accounts remove --yes (and revoke the key in your Anthropic Console)" "$fixed"
  elif [ -n "$legacy" ]; then diag_emit grid.accounts true true false "Claude tokens an earlier version stored are still in ~/.beethoven/accounts:$legacy. Beethoven never uses them and deletes nothing in that folder, which may hold your other Claude sign-ins now" "$fixed"
  else diag_emit grid.accounts true false false "no stored Claude tokens" "$fixed"; fi
  # lab access and the container
  if is_admin; then diag_emit grid.lab-access true false false "you are the lab admin"
  else case "$(student_state)" in
    approved) diag_emit grid.lab-access true false false "approved: the lab folder is readable";;
    pending|filed) diag_emit grid.lab-access true true false "requested; waiting for the lab admin";;
    denied|removed) diag_emit grid.lab-access false false false "$(student_state): $(status_field "$USER" message)";;
    approved_unreadable) diag_emit grid.lab-access false false false "approved, but the lab folder is not readable: the admin should run beethoven access admin resync";;
    *) diag_emit grid.lab-access false false false "not requested yet (the wizard's last step)";;
  esac; fi
  if is_ready; then diag_emit grid.container true false false "${CONTAINER:-own} ready: $(basename "$SANDBOX")"
  elif lib_granted && [ $repair = 1 ] && ( cmd_adopt "$(lib_default)" ) >/dev/null 2>&1 && is_ready; then diag_emit grid.container true false false "adopted the lab container" "ran beethoven adopt"
  elif lib_granted; then diag_emit grid.container false false false "the lab container is readable but not adopted (repair runs beethoven adopt)"
  else diag_emit grid.container false false false "no container yet: it comes with lab access"; fi
  if [ -n "$RUNTIME" ] && [ -x "$RUNTIME" ]; then diag_emit grid.runtime true false false "$RUNTIME"
  else
    local nr; nr=$(discover_runtime)
    if [ -n "$nr" ] && [ $repair = 1 ]; then set_cfg RUNTIME "$nr"; diag_emit grid.runtime true false false "$nr" "the runtime moved; now using $nr"
    elif [ -n "$nr" ]; then diag_emit grid.runtime false false false "configured runtime ${RUNTIME:-none} is gone; $nr is available (repair switches to it)"
    else diag_emit grid.runtime false false false "no apptainer runtime found (module load apptainer failed)"; fi
  fi
  # workers and the relay
  local wk any=0
  for wk in $(worker_dirs); do
    any=1; local wd="$BEETHOVEN_HOME/workers/$wk" jid st beat now; jid=$(cat "$wd/job.id" 2>/dev/null); st=$(job_state "$jid")
    beat=$(stat -c %Y "$wd/state.json" 2>/dev/null || echo 0); now=$(date +%s)
    case "$st" in
      RUNNING) if [ $((now - beat)) -lt 90 ]; then diag_emit "grid.worker.$wk" true false false "job $jid on $(cat "$wd/node" 2>/dev/null) alive"
               else diag_emit "grid.worker.$wk" false false false "job $jid runs but the daemon stopped answering $((now - beat)) s ago (repair restarts it)"; fi;;
      PENDING) diag_emit "grid.worker.$wk" true true false "job $jid waiting in the queue";;
      *) diag_emit "grid.worker.$wk" true false true "not running (${st:-no job})";;
    esac
  done
  [ $any = 1 ] || diag_emit grid.worker true false true "no worker started yet"
  # the license: the copy the laptop put here, and each running worker's own verdict (the daemon verifies it)
  if [ ! -s "$BEETHOVEN_HOME/license.key" ]; then diag_emit grid.license false false false "no Beethoven license on the grid (repair copies it from this laptop)"
  else
    local lw="" lb="" lstate
    for wk in $(worker_dirs); do local wd="$BEETHOVEN_HOME/workers/$wk"
      [ "$(job_state "$(cat "$wd/job.id" 2>/dev/null)")" = RUNNING ] || continue
      lstate=$(tr -d '\n' < "$wd/state.json" 2>/dev/null | grep -o '"license": *{[^}]*}' || true)
      if [ -z "$lstate" ]; then lb="$lb $wk (started before licensing; restart it)"
      elif echo "$lstate" | grep '"ok": *true' >/dev/null; then lw="$lw $wk"
      else lb="$lb $wk ($(echo "$lstate" | grep -o '"detail": *"[^"]*"' | cut -d'"' -f4))"; fi
    done
    if [ -n "$lb" ]; then diag_emit grid.license false false false "a worker refuses to run:$lb"
    elif [ -n "$lw" ]; then diag_emit grid.license true false false "license $(license_fp) accepted by:$lw"
    else diag_emit grid.license true false false "license $(license_fp) on the grid (no worker running to check it)"; fi
  fi
  # Slurm from inside the workers' containers: each worker tests it at start and puts it in its heartbeat
  local sw="" sb="" sold="" s
  for wk in $(worker_dirs); do local wd="$BEETHOVEN_HOME/workers/$wk"
    [ "$(job_state "$(cat "$wd/job.id" 2>/dev/null)")" = RUNNING ] || continue
    s=$(tr -d '\n' < "$wd/state.json" 2>/dev/null | grep -o '"slurm": *{[^}]*}' || true)
    if [ -z "$s" ]; then sold="$sold $wk"
    elif echo "$s" | grep '"ok": *true' >/dev/null; then sw="$sw $wk"
    else sb="$sb $wk ($(echo "$s" | grep -o '"detail": *"[^"]*"' | cut -d'"' -f4))"; fi
  done
  if [ -n "$sold" ] && [ $repair = 1 ]; then for wk in $sold; do "$BIN/beethoven" worker restart --name "$wk" >/dev/null 2>&1 || true; done; fi
  if [ -n "$sb" ]; then diag_emit grid.slurm-in-worker false false false "Slurm is not available inside:$sb"
  elif [ -n "$sold" ]; then diag_emit grid.slurm-in-worker false false false "started before grid scripts version 3, without Slurm inside:$sold (repair restarts them)" "$([ $repair = 1 ] && echo "restarted:$sold")"
  elif [ -n "$sw" ]; then diag_emit grid.slurm-in-worker true false false "Slurm works inside:$sw"
  else diag_emit grid.slurm-in-worker true false true "no worker running"; fi
  if printf 'PING\nQUIT\n' | timeout 20 "$BIN/beethoven" relay 2>/dev/null | grep '^PONG' >/dev/null; then diag_emit grid.relay true false false "the prompt relay answers"; else diag_emit grid.relay false false false "the prompt relay does not answer"; fi
  # the lab folder layout (admin only)
  if is_admin; then
    local bad=""; [ -n "$(find -L "$VOL" -maxdepth 0 -perm /o=rwx 2>/dev/null)" ] && bad="$bad volume-root-open"
    [ -d "$ACCESS_ROOT/inbox" ] && bad="$bad old-drop-box"
    # links are left out: a link's own mode is always rwxrwxrwx (shared/ashley -> beethoven, the old name)
    [ -n "$(find "$SHARED" -maxdepth 1 ! -type l -perm /o=w 2>/dev/null)" ] && bad="$bad world-writable-in-shared"
    if [ -z "$bad" ]; then diag_emit grid.lab-folder true false false "the volume root closed to other users (its list of approved accounts is the gate), nothing writable by others in shared/; requests via Slurm"
    elif [ $repair = 1 ] && cmd_access init >/dev/null 2>&1; then diag_emit grid.lab-folder true false false "layout restored" "ran beethoven access init"
    else diag_emit grid.lab-folder false false false "layout drifted:$bad"; fi
  else diag_emit grid.lab-folder true false true "admin only"; fi
  # the compute node, inside a running worker (slow; only with --node)
  if [ $node = 1 ]; then
    local jid=""; for wk in $(worker_dirs); do local j; j=$(cat "$BEETHOVEN_HOME/workers/$wk/job.id" 2>/dev/null); [ "$(job_state "$j")" = RUNNING ] && { jid=$j; break; }; done
    if [ -z "$jid" ]; then diag_emit node.probe true false true "no running worker to probe from"
    else
      local out; out=$(timeout 120 srun --jobid="$jid" --overlap -N1 -n1 --quiet "$BIN/beethoven" diag-node 2>&1)
      if echo "$out" | grep '^NODE-OK' >/dev/null; then diag_emit node.probe true false false "$(echo "$out" | grep '^NODE-OK' | cut -c9-)"
      else diag_emit node.probe false false false "$(echo "$out" | tail -3 | tr '\n' ' ' | cut -c1-300)"; fi
    fi
  fi
  echo ']}'
}
cmd_diag_node() { # runs on the compute node inside a worker allocation
  load_cfg
  # container commands never run on the login node (C&IT); this is only ever reached through srun
  [ -n "${SLURM_JOB_ID:-}" ] || { echo "NODE-FAIL container commands run only inside a Slurm job, not on $(hostname -s)"; return 1; }
  local S=/dev/shm/${USER}_diag_$$; mkdir -p "$S" || { echo "NODE-FAIL /dev/shm not writable"; return 1; }; trap 'rm -rf "$S"' RETURN
  # shellcheck disable=SC2086
  local out; out=$("$RUNTIME" exec $BINDS -B "$S:/tmp" "$SANDBOX" bash -c "node --version && '$CLAUDE_BIN' --version && command -v script >/dev/null && echo script-ok && curl -s -m 10 -o /dev/null -w '%{http_code}' https://api.anthropic.com/" 2>&1)
  if echo "$out" | grep 'script-ok' >/dev/null && echo "$out" | grep -E 'Claude Code' >/dev/null; then echo "NODE-OK $(hostname): $(echo "$out" | tr '\n' ' ' | cut -c1-200)"; else echo "NODE-FAIL $(hostname): $(echo "$out" | tail -4 | tr '\n' ' ')"; return 1; fi
}

cmd_verify_tokens() { # prove the stored tokens work, from the login node (tiny requests); prints names, never values
  [ -s "$BEETHOVEN_HOME/secrets.env" ] || { echo "no secrets.env"; return 1; }
  unset HF_TOKEN GITHUB_TOKEN GH_TOKEN
  # shellcheck disable=SC1090
  source "$BEETHOVEN_HOME/secrets.env"
  if [ -n "${HF_TOKEN:-}" ]; then
    local who; who=$(curl_auth "$HF_TOKEN" https://huggingface.co/api/whoami-v2 | grep -o '"name":"[^"]*"' | head -1 | cut -d'"' -f4)
    [ -n "$who" ] && echo "HF_TOKEN ok ($who)" || echo "HF_TOKEN rejected or unreachable"
  else echo "HF_TOKEN missing"; fi
  if [ -n "${GITHUB_TOKEN:-}" ]; then
    local gl; gl=$(curl_auth "$GITHUB_TOKEN" https://api.github.com/user | grep -o '"login": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')
    [ -n "$gl" ] && echo "GITHUB_TOKEN ok ($gl)" || echo "GITHUB_TOKEN rejected or unreachable"
  else echo "GITHUB_TOKEN missing"; fi
}
cmd_uninstall() { # takes away what `beethoven install` put in place, and only that
  # Up to grid scripts 8 this removed all of ~/.beethoven, and --purge-root the work folder. ~/.beethoven also
  # holds the Claude sign-in hpcworker's workers use (claude/), the engine's sign-ins and account list
  # (accounts/, engine/) and the session history (projects/, sessions/); on 2026-09-28 the whole folder,
  # sign-in included, vanished while a Remote Control session was open. Nothing of ours deletes those, the
  # work folder, or anything install did not make.
  case " $* " in *" --purge-root "*) die "your work folder is yours: Beethoven never deletes it. Nothing was removed.";; esac
  [ "${1:-}" = "--yes" ] || die "this stops your workers and removes Beethoven's scripts, settings, logs, worker folders and its block in ~/.bashrc; your Claude sign-in, your other accounts, your session history and your work folder stay: beethoven uninstall --yes"
  refuse_destructive_from_agent uninstall
  load_cfg
  # only the folder this command runs from, found through any link, never the home folder itself
  local real here; real=$(cd "$BEETHOVEN_HOME" 2>/dev/null && pwd -P) || real=""
  here=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P) || here=""
  case "$real" in ""|/|"$HOME"|"$(cd "$HOME" && pwd -P)") die "refusing to remove anything in '$BEETHOVEN_HOME' (resolves to '${real:-nothing}')";; esac
  [ "$here" = "$real/bin" ] || die "refusing: this command runs from ${here:-?}, not from $real/bin; nothing removed"
  for w in $(worker_dirs); do local jid; jid=$(cat "$BEETHOVEN_HOME/workers/$w/job.id" 2>/dev/null || echo ""); [ -n "$jid" ] && scancel "$jid" 2>/dev/null && echo "cancelled worker $w (job $jid)"; done
  local rc="$HOME/.bashrc"
  if [ -f "$rc" ] && has_bashrc_block "$rc"; then bashrc_rewrite "$rc" && echo "bashrc block removed"; fi
  # what install made, by name; rm on a link removes the link, and the scripts go last (bash has read this one)
  local e; for e in workers log config.env config.env.part READY READY.part bin; do
    [ -e "$real/$e" ] || [ -L "$real/$e" ] || continue
    rm -rf -- "${real:?}/$e" && echo "removed $real/$e"
  done
  # the folder, and the old name that led to it, only when nothing else is left in it
  if rmdir "$real" 2>/dev/null; then
    echo "removed $real"
    local l; for l in "$OLD_HOME" "$NEW_HOME" "$BEETHOVEN_HOME"; do [ -L "$l" ] && [ ! -e "$l" ] && rm -f "$l" && echo "removed the link $l"; done
  else
    # some of it Beethoven made (the copies of the tokens and the license key, the folders install made), and it
    # stays all the same: the sign-ins, the accounts and the history are never ours to delete, the tokens are
    # the student's to delete (LICENSE 5(a))
    echo "kept in $real: $(ls -A "$real" 2>/dev/null | tr '\n' ' ')(Beethoven removes only what install put in place; your Claude sign-in (claude), your other accounts (accounts, engine), your history (projects, sessions) and the copies of your tokens and license key (secrets.env, license.key) stay until you delete them yourself)"
  fi
  echo "Beethoven is uninstalled for ${USER:-$(id -un)}${ROOT:+; your work folder $ROOT is untouched}"
}

